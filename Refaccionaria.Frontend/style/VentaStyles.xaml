<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

<!-- =====================================================
             COLORES
             ===================================================== -->

        <SolidColorBrush
            x:Key="Fondo"
            Color="#181818"/>

        <SolidColorBrush
            x:Key="PanelOscuro"
            Color="#202020"/>

        <SolidColorBrush
            x:Key="Superficie"
            Color="#292929"/>

        <SolidColorBrush
            x:Key="Campo"
            Color="#303030"/>

        <SolidColorBrush
            x:Key="CampoHover"
            Color="#393939"/>

        <SolidColorBrush
            x:Key="BordeCampo"
            Color="#505050"/>

        <SolidColorBrush
            x:Key="BordeSuave"
            Color="#3A3A3A"/>

        <SolidColorBrush
            x:Key="Rojo"
            Color="#D80D2E"/>

        <SolidColorBrush
            x:Key="RojoHover"
            Color="#EF1238"/>

        <SolidColorBrush
            x:Key="RojoOscuro"
            Color="#A90A23"/>

        <SolidColorBrush
            x:Key="RojoClaro"
            Color="#FF405B"/>

        <SolidColorBrush
            x:Key="Amarillo"
            Color="#FFC107"/>

        <SolidColorBrush
            x:Key="AmarilloHover"
            Color="#FFD54F"/>

        <SolidColorBrush
            x:Key="Negro"
            Color="#111111"/>

        <SolidColorBrush
            x:Key="GrisTexto"
            Color="#A0A0A0"/>

        <SolidColorBrush
            x:Key="BlancoCatalogo"
            Color="#F8F8F8"/>

        <SolidColorBrush
            x:Key="TextoOscuro"
            Color="#202020"/>

        <SolidColorBrush
            x:Key="TextoGrisClaro"
            Color="#737373"/>


        <!-- =====================================================
             COMBOBOX
             ===================================================== -->

        <SolidColorBrush
            x:Key="ComboBoxBackground"
            Color="#303030"/>

        <SolidColorBrush
            x:Key="ComboBoxBackgroundPointerOver"
            Color="#393939"/>

        <SolidColorBrush
            x:Key="ComboBoxBackgroundPressed"
            Color="#393939"/>

        <SolidColorBrush
            x:Key="ComboBoxBackgroundFocused"
            Color="#303030"/>

        <SolidColorBrush
            x:Key="ComboBoxBorderBrush"
            Color="#505050"/>

        <SolidColorBrush
            x:Key="ComboBoxBorderBrushPointerOver"
            Color="#707070"/>

        <SolidColorBrush
            x:Key="ComboBoxBorderBrushPressed"
            Color="#D80D2E"/>

        <SolidColorBrush
            x:Key="ComboBoxBorderBrushFocused"
            Color="#D80D2E"/>

        <SolidColorBrush
            x:Key="ComboBoxDropDownBackground"
            Color="#292929"/>

        <SolidColorBrush
            x:Key="ComboBoxDropDownBorderBrush"
            Color="#505050"/>


        <!-- =====================================================
             BOTÓN PRINCIPAL
             ===================================================== -->

        <Style
            x:Key="BotonPrimario"
            TargetType="Button">

            <Setter
                Property="Background"
                Value="{StaticResource Rojo}"/>

            <Setter
                Property="Foreground"
                Value="White"/>

            <Setter
                Property="FontWeight"
                Value="Bold"/>

            <Setter
                Property="FontSize"
                Value="13"/>

            <Setter
                Property="Padding"
                Value="16,10"/>

            <Setter Property="CornerRadius"
                    Value="5"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            x:Name="fondo"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">

                            <VisualStateManager.VisualStateGroups>

                                <VisualStateGroup
                                    x:Name="CommonStates">

                                    <VisualState
                                        x:Name="Normal"/>

                                    <VisualState
                                        x:Name="PointerOver">

                                        <VisualState.Setters>

                                            <Setter
                                                Target="fondo.Background"
                                                Value="{StaticResource RojoHover}"/>

                                        </VisualState.Setters>

                                    </VisualState>

                                    <VisualState
                                        x:Name="Pressed">

                                        <VisualState.Setters>

                                            <Setter
                                                Target="fondo.Background"
                                                Value="{StaticResource RojoOscuro}"/>

                                        </VisualState.Setters>

                                    </VisualState>

                                    <VisualState
                                        x:Name="Disabled">

                                        <VisualState.Setters>

                                            <Setter
                                                Target="fondo.Background"
                                                Value="#AAAAAA"/>

                                            <Setter
                                                Target="contenido.Foreground"
                                                Value="#EEEEEE"/>

                                        </VisualState.Setters>

                                    </VisualState>

                                </VisualStateGroup>

                            </VisualStateManager.VisualStateGroups>

                            <ContentPresenter
                                x:Name="contenido"
                                Content="{TemplateBinding Content}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- =====================================================
             BOTÓN SECUNDARIO
             ===================================================== -->

        <Style
            x:Key="BotonSecundario"
            TargetType="Button">

            <Setter
                Property="Foreground"
                Value="White"/>

            <Setter
                Property="FontWeight"
                Value="SemiBold"/>

            <Setter
                Property="FontSize"
                Value="13"/>

            <Setter
                Property="Padding"
                Value="14,10"/>

            <Setter Property="CornerRadius"
                    Value="5"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            x:Name="fondo"
                            Background="{StaticResource Campo}"
                            BorderBrush="{StaticResource BordeCampo}"
                            BorderThickness="1"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">

                            <VisualStateManager.VisualStateGroups>

                                <VisualStateGroup
                                    x:Name="CommonStates">

                                    <VisualState
                                        x:Name="Normal"/>

                                    <VisualState
                                        x:Name="PointerOver">

                                        <VisualState.Setters>

                                            <Setter
                                                Target="fondo.Background"
                                                Value="{StaticResource CampoHover}"/>

                                            <Setter
                                                Target="fondo.BorderBrush"
                                                Value="#707070"/>

                                        </VisualState.Setters>

                                    </VisualState>

                                    <VisualState
                                        x:Name="Pressed"/>

                                    <VisualState
                                        x:Name="Disabled"/>

                                </VisualStateGroup>

                            </VisualStateManager.VisualStateGroups>

                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- =====================================================
             BOTÓN CONTORNO ROJO
             ===================================================== -->

        <Style
            x:Key="BotonContorno"
            TargetType="Button">

            <Setter
                Property="Foreground"
                Value="{StaticResource RojoClaro}"/>

            <Setter
                Property="FontWeight"
                Value="SemiBold"/>

            <Setter
                Property="FontSize"
                Value="12"/>

            <Setter
                Property="Padding"
                Value="14,9"/>

            <Setter Property="CornerRadius"
                    Value="4"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            x:Name="fondo"
                            Background="Transparent"
                            BorderBrush="{StaticResource Rojo}"
                            BorderThickness="1"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">

                            <VisualStateManager.VisualStateGroups>

                                <VisualStateGroup
                                    x:Name="CommonStates">

                                    <VisualState
                                        x:Name="Normal"/>

                                    <VisualState
                                        x:Name="PointerOver">

                                        <VisualState.Setters>

                                            <Setter
                                                Target="fondo.Background"
                                                Value="#3A1017"/>

                                        </VisualState.Setters>

                                    </VisualState>

                                    <VisualState
                                        x:Name="Pressed"/>

                                    <VisualState
                                        x:Name="Disabled"/>

                                </VisualStateGroup>

                            </VisualStateManager.VisualStateGroups>

                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- =====================================================
             BOTONES + Y -
             ===================================================== -->

        <Style
            x:Key="BotonCantidad"
            TargetType="Button">

            <Setter Property="Width"
                    Value="28"/>
            <Setter Property="Height"
                    Value="28"/>
            <Setter Property="FontSize"
                    Value="15"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            x:Name="fondo"
                            Background="{StaticResource Campo}"
                            BorderBrush="{StaticResource BordeCampo}"
                            BorderThickness="1"
                            CornerRadius="4">

                            <VisualStateManager.VisualStateGroups>

                                <VisualStateGroup
                                    x:Name="CommonStates">

                                    <VisualState x:Name="Normal"/>

                                    <VisualState x:Name="PointerOver">

                                        <VisualState.Setters>

                                            <Setter
                                                Target="fondo.Background"
                                                Value="{StaticResource Rojo}"/>

                                            <Setter
                                                Target="fondo.BorderBrush"
                                                Value="{StaticResource Rojo}"/>

                                        </VisualState.Setters>

                                    </VisualState>

                                    <VisualState x:Name="Pressed"/>
                                    <VisualState x:Name="Disabled"/>

                                </VisualStateGroup>

                            </VisualStateManager.VisualStateGroups>

                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- =====================================================
             BOTÓN QUITAR
             ===================================================== -->

        <Style
            x:Key="BotonQuitar"
            TargetType="Button">

            <Setter Property="Width"
                    Value="26"/>
            <Setter Property="Height"
                    Value="26"/>
            <Setter Property="FontSize"
                    Value="12"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Foreground"
                    Value="{StaticResource GrisTexto}"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            x:Name="fondo"
                            Background="Transparent"
                            CornerRadius="13">

                            <VisualStateManager.VisualStateGroups>

                                <VisualStateGroup x:Name="CommonStates">

                                    <VisualState x:Name="Normal"/>

                                    <VisualState x:Name="PointerOver">

                                        <VisualState.Setters>

                                            <Setter
                                                Target="fondo.Background"
                                                Value="#3A1017"/>

                                            <Setter
                                                Target="contenido.Foreground"
                                                Value="{StaticResource RojoClaro}"/>

                                        </VisualState.Setters>

                                    </VisualState>

                                    <VisualState x:Name="Pressed"/>
                                    <VisualState x:Name="Disabled"/>

                                </VisualStateGroup>

                            </VisualStateManager.VisualStateGroups>

                            <ContentPresenter
                                x:Name="contenido"
                                Content="{TemplateBinding Content}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- =====================================================
             CERRAR TICKET
             ===================================================== -->

        <Style
            x:Key="BotonCerrarPanel"
            TargetType="Button">

            <Setter Property="Width"
                    Value="30"/>
            <Setter Property="Height"
                    Value="30"/>
            <Setter Property="FontSize"
                    Value="13"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            x:Name="fondo"
                            Background="{StaticResource RojoOscuro}"
                            CornerRadius="15">

                            <VisualStateManager.VisualStateGroups>

                                <VisualStateGroup x:Name="CommonStates">

                                    <VisualState x:Name="Normal"/>

                                    <VisualState x:Name="PointerOver">

                                        <VisualState.Setters>

                                            <Setter
                                                Target="fondo.Background"
                                                Value="{StaticResource RojoHover}"/>

                                        </VisualState.Setters>

                                    </VisualState>

                                    <VisualState x:Name="Pressed"/>
                                    <VisualState x:Name="Disabled"/>

                                </VisualStateGroup>

                            </VisualStateManager.VisualStateGroups>

                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- =====================================================
             FILTROS DE CATEGORÍA
             ===================================================== -->

        <Style
            x:Key="Pildora"
            TargetType="RadioButton">

            <Setter Property="Margin"
                    Value="0,0,8,6"/>
            <Setter Property="FontSize"
                    Value="12"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Foreground"
                    Value="#D0D0D0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="RadioButton">

                        <Border
                            x:Name="fondo"
                            Background="{StaticResource Campo}"
                            BorderBrush="{StaticResource BordeSuave}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="18,9">

                            <VisualStateManager.VisualStateGroups>

                                <VisualStateGroup
                                    x:Name="CommonStates">

                                    <VisualState x:Name="Normal"/>

                                    <VisualState x:Name="PointerOver">

                                        <VisualState.Setters>

                                            <Setter
                                                Target="fondo.Background"
                                                Value="{StaticResource CampoHover}"/>

                                        </VisualState.Setters>

                                    </VisualState>

                                    <VisualState x:Name="Pressed"/>
                                    <VisualState x:Name="Disabled"/>

                                </VisualStateGroup>

                                <VisualStateGroup
                                    x:Name="CheckStates">

                                    <VisualState x:Name="Unchecked"/>

                                    <VisualState x:Name="Checked">

                                        <VisualState.Setters>

                                            <Setter
                                                Target="fondo.Background"
                                                Value="{StaticResource Rojo}"/>

                                            <Setter
                                                Target="fondo.BorderBrush"
                                                Value="{StaticResource Rojo}"/>

                                            <Setter
                                                Target="contenido.Foreground"
                                                Value="White"/>

                                        </VisualState.Setters>

                                    </VisualState>

                                    <VisualState x:Name="Indeterminate"/>

                                </VisualStateGroup>

                            </VisualStateManager.VisualStateGroups>

                            <ContentPresenter
                                x:Name="contenido"
                                Content="{TemplateBinding Content}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- =====================================================
             BUSCADOR
             ===================================================== -->

        <Style
            x:Key="CajaBusqueda"
            TargetType="TextBox">

            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Padding"
                    Value="45,10,12,10"/>
            <Setter Property="BorderThickness"
                    Value="2"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource BordeCampo}"/>
            <Setter Property="Background"
                    Value="{StaticResource Campo}"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="CornerRadius"
                    Value="5"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border
                            x:Name="fondo"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">

                            <VisualStateManager.VisualStateGroups>

                                <VisualStateGroup x:Name="CommonStates">

                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="Disabled"/>

                                </VisualStateGroup>

                                <VisualStateGroup x:Name="FocusStates">

                                    <VisualState x:Name="Unfocused"/>

                                    <VisualState x:Name="Focused">

                                        <VisualState.Setters>

                                            <Setter
                                                Target="fondo.BorderBrush"
                                                Value="{StaticResource Rojo}"/>

                                        </VisualState.Setters>

                                    </VisualState>

                                </VisualStateGroup>

                            </VisualStateManager.VisualStateGroups>

                            <ScrollViewer
                                x:Name="ContentElement"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- =====================================================
             CAJA TEXTO NORMAL
             ===================================================== -->

        <Style
            x:Key="CajaTexto"
            TargetType="TextBox">

            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Padding"
                    Value="10,9"/>
            <Setter Property="BorderThickness"
                    Value="2"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource BordeCampo}"/>
            <Setter Property="Background"
                    Value="{StaticResource Campo}"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="CornerRadius"
                    Value="4"/>

        </Style>


        <!-- =====================================================
             ETIQUETA
             ===================================================== -->

        <Style
            x:Key="Etiqueta"
            TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="12"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Foreground"
                    Value="{StaticResource GrisTexto}"/>
            <Setter Property="Margin"
                    Value="0,0,0,6"/>

        </Style>


        <!-- =====================================================
             COMBOBOX
             ===================================================== -->

        <Style
            x:Key="Lista"
            TargetType="ComboBox">

            <Setter Property="FontSize"
                    Value="12"/>
            <Setter Property="Height"
                    Value="40"/>
            <Setter Property="Padding"
                    Value="10,3"/>
            <Setter Property="CornerRadius"
                    Value="4"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Background"
                    Value="{StaticResource Campo}"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource BordeCampo}"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>

</ResourceDictionary>

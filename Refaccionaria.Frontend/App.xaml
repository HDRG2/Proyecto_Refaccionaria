<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Refaccionaria.Frontend.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
                <ResourceDictionary Source="ms-appx:///style/Estilos.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Estilos por defecto para los TextBox del Login -->
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="#262626"/>
                <Setter Property="BorderBrush" Value="#262626"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="CornerRadius" Value="0"/>
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="FontSize" Value="15"/>
            </Style>

            <Style TargetType="PasswordBox">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="#262626"/>
                <Setter Property="BorderBrush" Value="#262626"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="CornerRadius" Value="0"/>
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="FontSize" Value="15"/>
            </Style>

            <!-- Botón Estilo Asfalto/Amarillo -->
            <Style x:Key="BtnNegroIndustrial" TargetType="Button">
                <Setter Property="Background" Value="#262626"/>
                <Setter Property="Foreground" Value="#FFC20E"/>
                <Setter Property="BorderBrush" Value="#262626"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="CornerRadius" Value="0"/>
                <Setter Property="FontWeight" Value="ExtraBold"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Padding" Value="16,10"/>
            </Style>

            <!-- Botón Estilo Blanco/Negro -->
            <Style x:Key="BtnBlancoIndustrial" TargetType="Button">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="#262626"/>
                <Setter Property="BorderBrush" Value="#262626"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="CornerRadius" Value="0"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Padding" Value="14,8"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

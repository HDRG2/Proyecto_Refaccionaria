<Page
    x:Class="Refaccionaria.Frontend.Views.MainPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Refaccionaria.Frontend.Views"
    xmlns:models="using:Refaccionaria.Frontend.Models"
    xmlns:converters="using:Refaccionaria.Frontend.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#E8E6E1">

    <Page.Resources>
        <converters:CeroAVisibleConverter x:Key="CeroAVisibleConverter"/>
        <converters:MarcaConTituloConverter x:Key="MarcaConTituloConverter"/>
        <converters:PorcentajeAAnchoConverter x:Key="PorcentajeAAnchoConverter"/>
        <converters:StockBajoABrushConverter x:Key="StockBajoABrushConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ FILA 0: BARRA SUPERIOR ============ -->

        <Grid Grid.Row="0"
              Background="#262626"
              Padding="24,0"
              Height="68">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">

                <Border Background="#FFC20E"
                        Width="28"
                        Height="28"
                        CornerRadius="4">

                    <TextBlock Text="&#128736;"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="EL PISTÓN"
                           Foreground="#FFC20E"
                           FontWeight="ExtraBold"
                           FontSize="20"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Center"
                        Margin="28,0,0,0">

                <Button Content="Inventario"
                        Background="Transparent"
                        BorderThickness="0,0,0,3"
                        BorderBrush="#FFC20E"
                        Foreground="#FFC20E"
                        FontWeight="Bold"
                        CornerRadius="0"
                        Padding="14,10"/>

                <Button Content="Ventas"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#BDBDBD"
                        Padding="14,10"/>

                <Button Content="Clientes"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#BDBDBD"
                        Padding="14,10"/>

                <Button Content="Proveedores"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#BDBDBD"
                        Padding="14,10"/>

                <Button Content="+ Nueva pieza"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#FFC20E"
                        FontWeight="Bold"
                        Padding="14,10"
                        Click="NuevaPieza_Click"/>
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="16"
                        VerticalAlignment="Center">

                <TextBlock VerticalAlignment="Center"
                           Foreground="#DDDDDD">

                    <Run Text="{x:Bind _nombreUsuario}"
                         FontWeight="Bold"
                         Foreground="White"/>
                    <Run Text=", Administrador"/>

                    <Run Text=", Mostrador"/>
                </TextBlock>

                <Button Content="Salir"
                        Background="Transparent"
                        BorderBrush="#FFC20E"
                        BorderThickness="2"
                        Foreground="#FFC20E"
                        Padding="12,6"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="0"
                Height="6"
                VerticalAlignment="Bottom"
                Background="#FFC20E"/>

        <!-- ============ FILA 1: BANNER + BUSCADOR ============ -->

        <Grid Grid.Row="1"
              Background="#171717"
              Height="200">

            <Border Background="#262626"
                    BorderBrush="#FFC20E"
                    BorderThickness="3"
                    Padding="20,18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="620">

                <StackPanel Spacing="4">

                    <TextBlock Text="Almacén"
                               FontSize="34"
                               FontWeight="ExtraBold"
                               Foreground="#FFC20E"/>

                    <TextBlock Foreground="#BDBDBD"
                               FontSize="13.5">

                        <Run Text="{x:Bind ViewModel.TotalPiezas, Mode=OneWay}"
                             FontWeight="Bold"
                             Foreground="White"/>

                        <Run Text=" piezas registradas · "/>

                        <Run Text="{x:Bind ViewModel.PiezasEnExistencia, Mode=OneWay}"
                             FontWeight="Bold"
                             Foreground="White"/>

                        <Run Text=" en existencia · "/>

                        <Run Text="{x:Bind ViewModel.PiezasPorResurtir, Mode=OneWay}"
                             FontWeight="Bold"
                             Foreground="White"/>

                        <Run Text=" por resurtir"/>
                    </TextBlock>

                    <Grid Margin="0,10,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 x:Name="BuscarBox"
                                 PlaceholderText="Pieza, código, marca o auto…"
                                 Height="46"
                                 Margin="0,0,10,0"
                                 TextChanged="Buscar_TextChanged"/>

                        <Button Grid.Column="1"
                                Content="Buscar"
                                Background="#FFC20E"
                                Height="46"
                                Padding="20,0"
                                FontWeight="Bold"
                                Foreground="#262626"
                                BorderBrush="#262626"
                                BorderThickness="2"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ FILA 2: SIDEBAR + CATÁLOGO ============ -->

        <ScrollViewer Grid.Row="2"
                      Background="#E8E6E1">

            <Grid Margin="0,0,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="312"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== SIDEBAR (oscuro) ===== -->

                <Border Grid.Column="0"
                        Background="#1B1B1B">

                    <StackPanel Spacing="16"
                                Padding="24,26,24,40">

                        <!-- Bloque: filtro por auto -->

                        <Border BorderBrush="#FFC20E"
                                BorderThickness="2"
                                Background="#262626">

                            <StackPanel>

                                <Border Background="#FFC20E"
                                        Padding="14,11">

                                    <TextBlock Text="¿QUÉ AUTO TRAE EL CLIENTE?"
                                               Foreground="#262626"
                                               FontWeight="Bold"
                                               FontSize="13"/>
                                </Border>

                                <StackPanel Padding="14"
                                            Spacing="10">

                                    <TextBlock Text="Elige marca y modelo y abajo sólo quedan las piezas que le quedan a ese auto."
                                               Foreground="#BDBDBD"
                                               FontSize="13"
                                               TextWrapping="Wrap"/>

                                    <StackPanel Spacing="4">

                                        <TextBlock Text="Marca"
                                                   FontWeight="Bold"
                                                   Foreground="#FFC20E"
                                                   FontSize="13"/>

                                        <ComboBox ItemsSource="{x:Bind ViewModel.Marcas}"
                                                  SelectedItem="{x:Bind ViewModel.MarcaSeleccionada, Mode=TwoWay}"
                                                  PlaceholderText="Cualquier marca"
                                                  HorizontalAlignment="Stretch"/>
                                    </StackPanel>

                                    <StackPanel Spacing="4">

                                        <TextBlock Text="Modelo"
                                                   FontWeight="Bold"
                                                   Foreground="#FFC20E"
                                                   FontSize="13"/>

                                        <ComboBox ItemsSource="{x:Bind ViewModel.Modelos, Mode=OneWay}"
                                                  SelectedItem="{x:Bind ViewModel.ModeloSeleccionado, Mode=TwoWay}"
                                                  PlaceholderText="Cualquier modelo"
                                                  HorizontalAlignment="Stretch"/>
                                    </StackPanel>

                                    <Button Content="Limpiar búsqueda"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            BorderBrush="#FFC20E"
                                            BorderThickness="2"
                                            Background="#1B1B1B"
                                            Foreground="#FFC20E"
                                            FontWeight="Bold"
                                            Command="{x:Bind ViewModel.LimpiarFiltrosCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Bloque: tipo de pieza (chips) -->

                        <Border BorderBrush="#FFC20E"
                                BorderThickness="2"
                                Background="#262626">

                            <StackPanel>

                                <Border Background="#FFC20E"
                                        Padding="14,11">

                                    <TextBlock Text="TIPO DE PIEZA"
                                               Foreground="#262626"
                                               FontWeight="Bold"
                                               FontSize="13"/>
                                </Border>

                                <ItemsControl Padding="14"
                                              ItemsSource="{x:Bind ViewModel.Categorias}">

                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsWrapGrid Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate x:DataType="x:String">

                                            <Button Content="{x:Bind}"
                                                    Margin="0,0,6,6"
                                                    BorderBrush="#FFC20E"
                                                    BorderThickness="2"
                                                    Background="#1B1B1B"
                                                    Foreground="#FFC20E"
                                                    Padding="9,5"
                                                    FontWeight="Bold"
                                                    FontSize="12"
                                                    Command="{Binding ElementName=RootPage, Path=ViewModel.SeleccionarCategoriaCommand}"
                                                    CommandParameter="{x:Bind}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Bloque: alertas de resurtido -->

                        <Border BorderBrush="#FFC20E"
                                BorderThickness="2"
                                Background="#262626">

                            <StackPanel>

                                <Border Background="#B3261E"
                                        Padding="14,11">

                                    <TextBlock Text="HAY QUE RESURTIR"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               FontSize="13"/>
                                </Border>

                                <ItemsControl Padding="14"
                                              ItemsSource="{x:Bind ViewModel.Alertas, Mode=OneWay}">

                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate x:DataType="models:Refaccion">

                                            <Button HorizontalAlignment="Stretch"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0,9"
                                                    HorizontalContentAlignment="Stretch"
                                                    Command="{Binding ElementName=RootPage, Path=ViewModel.IrAAlertaCommand}"
                                                    CommandParameter="{x:Bind}">

                                                <Grid>

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0"
                                                                HorizontalAlignment="Left">

                                                        <TextBlock Text="{x:Bind Nombre}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="White"
                                                                   FontSize="13.5"/>

                                                        <TextBlock Text="{x:Bind Codigo}"
                                                                   FontSize="12"
                                                                   Foreground="#BDBDBD"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{x:Bind Stock}"
                                                               FontWeight="Bold"
                                                               Foreground="#FF6B5E"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Todo con existencia suficiente."
                                           Foreground="#BDBDBD"
                                           FontSize="13.5"
                                           Padding="14"
                                           Visibility="{x:Bind ViewModel.Alertas.Count, Mode=OneWay, Converter={StaticResource CeroAVisibleConverter}}"/>
                            </StackPanel>
                        </Border>

                        <!-- Bloque: estadísticas -->

                        <Border BorderBrush="#FFC20E"
                                BorderThickness="2"
                                Background="#262626">

                            <StackPanel>

                                <Border Background="#FFC20E"
                                        Padding="14,11">

                                    <TextBlock Text="CÓMO VA EL ALMACÉN"
                                               Foreground="#262626"
                                               FontWeight="Bold"
                                               FontSize="13"/>
                                </Border>

                                <Grid Padding="14"
                                      ColumnSpacing="12"
                                      RowSpacing="12">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Column="0"
                                                Grid.Row="0"
                                                BorderThickness="4,0,0,0"
                                                BorderBrush="#FFC20E"
                                                Padding="8,0,0,0">

                                        <TextBlock Text="Marcas que manejas"
                                                   FontSize="12"
                                                   Foreground="#BDBDBD"/>

                                        <TextBlock Text="{x:Bind ViewModel.MarcasCount, Mode=OneWay}"
                                                   FontWeight="ExtraBold"
                                                   Foreground="White"
                                                   FontSize="24"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Grid.Row="0"
                                                BorderThickness="4,0,0,0"
                                                BorderBrush="#FFC20E"
                                                Padding="8,0,0,0">

                                        <TextBlock Text="Autos cubiertos"
                                                   FontSize="12"
                                                   Foreground="#BDBDBD"/>

                                        <TextBlock Text="{x:Bind ViewModel.AutosCount, Mode=OneWay}"
                                                   FontWeight="ExtraBold"
                                                   Foreground="White"
                                                   FontSize="24"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Grid.Row="1"
                                                BorderThickness="4,0,0,0"
                                                BorderBrush="#FFC20E"
                                                Padding="8,0,0,0">

                                        <TextBlock Text="Valor del inventario"
                                                   FontSize="12"
                                                   Foreground="#BDBDBD"/>

                                        <TextBlock Text="{x:Bind ViewModel.ValorInventarioTexto, Mode=OneWay}"
                                                   FontWeight="ExtraBold"
                                                   Foreground="#FFC20E"
                                                   FontSize="24"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ===== CATÁLOGO (claro, con más color) ===== -->

                <StackPanel Grid.Column="1"
                            Margin="32,26,32,40">

                    <Grid Margin="0,0,0,16">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock Text="Piezas en catálogo"
                                       FontSize="26"
                                       FontWeight="ExtraBold"
                                       Foreground="#262626"/>

                            <TextBlock Text="{x:Bind ViewModel.ResumenFiltros, Mode=OneWay}"
                                       Foreground="#6B6B6B"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <ComboBox x:Name="OrdenCombo"
                                  Header="Ordenar por"
                                  PlaceholderText="Selecciona un criterio"
                                  SelectionChanged="OrdenCombo_SelectionChanged"
                                  Width="220"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Bottom">

                            <ComboBoxItem Content="Nombre (A-Z)"
                                    Tag="NombreAsc"/>
                            <ComboBoxItem Content="Nombre (Z-A)"
                                    Tag="NombreDesc"/>
                            <ComboBoxItem Content="Precio: Menor a Mayor"
                                    Tag="PrecioAsc"/>
                            <ComboBoxItem Content="Precio: Mayor a Menor"
                                    Tag="PrecioDesc"/>
                            <ComboBoxItem Content="Stock disponible"
                                    Tag="Stock"/>
                        </ComboBox>
                    </Grid>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Catalogo, Mode=OneWay}">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>

                            <DataTemplate x:DataType="models:Refaccion">

                                <Grid Width="256"
                                      Margin="0,0,18,18">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="#FFC20E"/>

                                    <Border Grid.Column="1"
                                            BorderBrush="#262626"
                                            BorderThickness="2,2,2,2"
                                            Background="#FFFBF0">

                                        <StackPanel>

                                            <Grid Background="#262626"
                                                  Padding="13,9">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{x:Bind Codigo}"
                                                           FontWeight="ExtraBold"
                                                           Foreground="#FFC20E"
                                                           FontSize="18"/>

                                                <Border Grid.Column="1"
                                                        Background="#FFC20E"
                                                        BorderBrush="#262626"
                                                        BorderThickness="2"
                                                        Padding="6,2">

                                                    <TextBlock Text="{x:Bind CategoriaNombre}"
                                                               FontWeight="Bold"
                                                               Foreground="#262626"
                                                               FontSize="11"/>
                                                </Border>
                                            </Grid>

                                            <StackPanel Padding="13"
                                                        Spacing="4">

                                                <TextBlock Text="{x:Bind Nombre}"
                                                           FontWeight="ExtraBold"
                                                           FontSize="16"
                                                           Foreground="#262626"
                                                           TextWrapping="Wrap"/>

                                                <TextBlock Text="{x:Bind MarcaNombre, Converter={StaticResource MarcaConTituloConverter}}"
                                                           FontSize="13"
                                                           Foreground="#B3261E"
                                                           FontWeight="SemiBold"/>

                                                <ItemsControl ItemsSource="{x:Bind AutosDescripciones}"
                                                              Margin="0,6,0,0">

                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <ItemsWrapGrid Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>

                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <Border Background="#FFF4CC"
                                                                    BorderBrush="#FFC20E"
                                                                    BorderThickness="1"
                                                                    Margin="0,0,4,4"
                                                                    Padding="6,2"
                                                                    CornerRadius="2">
                                                                <TextBlock Text="{x:Bind}"
                                                                           FontSize="11"
                                                                           Foreground="#262626"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Grid Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0"
                                                                Orientation="Horizontal">
                                                        <TextBlock Text="$"
                                                                   FontWeight="ExtraBold"
                                                                   FontSize="18"
                                                                   Foreground="#262626"/>
                                                        <TextBlock Text="{x:Bind Precio}"
                                                                   FontWeight="ExtraBold"
                                                                   FontSize="18"
                                                                   Foreground="#262626"/>
                                                    </StackPanel>

                                                    <Border Grid.Column="1"
                                                            Background="{x:Bind StockBajo, Converter={StaticResource StockBajoABrushConverter}}"
                                                            BorderBrush="#262626"
                                                            BorderThickness="1"
                                                            Padding="8,3"
                                                            CornerRadius="4">
                                                        <TextBlock FontSize="12"
                                                                   FontWeight="Bold"
                                                                   Foreground="White">
                                                            <Run Text="{x:Bind Stock}"/>
                                                            <Run Text=" disp."/>
                                                        </TextBlock>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>







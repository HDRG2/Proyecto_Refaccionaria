<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="Refaccionaria.Frontend.Views.PanelAdmin"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Refaccionaria.Frontend.Models"
    xmlns:conv="using:Refaccionaria.Frontend.Converters"
    FontFamily="Segoe UI"
    Loaded="Page_Loaded"
    KeyDown="Ventana_KeyDown">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///style/AdminStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>


    <!-- ============================================================= -->
    <!-- CONTENEDOR PRINCIPAL -->
    <!-- ============================================================= -->

    <Grid Background="{StaticResource GrisFondo}">

        <Grid.RowDefinitions>

            <RowDefinition Height="70"/>

            <RowDefinition Height="4"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- ========================================================= -->
        <!-- BARRA SUPERIOR -->
        <!-- ========================================================= -->

        <Grid
            Grid.Row="0"
            Background="{StaticResource GrisMuyOscuro}">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="Auto"/>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <!-- LOGO -->

            <StackPanel
                Grid.Column="0"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Margin="24,0,0,0">

                <Border
                    Width="42"
                    Height="42"
                    CornerRadius="8"
                    Background="{StaticResource RojoRefaccionaria}">

                    <TextBlock
                        Text="⚙"
                        FontSize="25"
                        Foreground="White"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                </Border>

                <StackPanel
                    Margin="12,0,0,0"
                    VerticalAlignment="Center">

                    <TextBlock
                        Text="EL PISTÓN"
                        FontSize="21"
                        FontWeight="Bold"
                        Foreground="{StaticResource AmarilloRefaccionaria}"/>

                    <TextBlock
                        Text="ADMINISTRACIÓN"
                        FontSize="9"
                        FontWeight="SemiBold"
                        Foreground="#AAAAAA"/>

                </StackPanel>

            </StackPanel>


            <!-- TÍTULO -->

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

                <TextBlock
                    Text="PANEL DE ADMINISTRADOR"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="White"/>

            </StackPanel>


            <!-- USUARIO -->

            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Margin="0,0,24,0">

                <StackPanel
                    Margin="0,0,16,0">

                    <TextBlock
                        x:Name="TxtUsuarioActual"
                        Text="admin"
                        Foreground="White"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Right"/>

                    <TextBlock
                        Text="Administrador"
                        Foreground="#AAAAAA"
                        FontSize="11"
                        HorizontalAlignment="Right"/>

                </StackPanel>

                <Button
                    Content="Salir"
                    Style="{StaticResource BotonRojo}"
                    Click="Salir_Click"/>

            </StackPanel>

        </Grid>


        <!-- FRANJA AMARILLA -->

        <Border
            Grid.Row="1"
            Background="{StaticResource AmarilloRefaccionaria}"/>


        <!-- ========================================================= -->
        <!-- CUERPO -->
        <!-- ========================================================= -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="235"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>


            <!-- ===================================================== -->
            <!-- BARRA LATERAL -->
            <!-- ===================================================== -->

            <Grid
                Grid.Column="0"
                Background="{StaticResource GrisOscuro}">

                <Grid.RowDefinitions>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <!-- MENÚ -->

                <StackPanel
                    Grid.Row="0"
                    Margin="12,22,12,0">


                    <TextBlock
                        Text="ADMINISTRACIÓN"
                        FontSize="10"
                        FontWeight="Bold"
                        Foreground="#888888"
                        Margin="18,0,0,12"/>


                    <!-- INVENTARIO -->

                    <RadioButton
                        x:Name="MenuInventario"
                        Style="{StaticResource BotonMenuAdmin}"
                        IsChecked="True"
                        Checked="Menu_Checked">

                        <StackPanel
                            Orientation="Horizontal">

                            <TextBlock
                                Text="📦"
                                FontSize="17"
                                Width="30"/>

                            <TextBlock
                                Text="Inventario"
                                VerticalAlignment="Center"/>

                        </StackPanel>

                    </RadioButton>


                    <!-- AGREGAR -->

                    <RadioButton
                        x:Name="MenuAgregarProducto"
                        Style="{StaticResource BotonMenuAdmin}"
                        Checked="Menu_Checked">
                    </RadioButton>


                    <!-- EDITAR -->

                    <RadioButton
                        x:Name="MenuEditarProducto"
                        Style="{StaticResource BotonMenuAdmin}"
                        Checked="Menu_Checked">

                        <StackPanel
                            Orientation="Horizontal">

                            <TextBlock
                                Text="✎"
                                FontSize="19"
                                Width="30"
                                Foreground="#CCCCCC"/>

                            <TextBlock
                                Text="Editar producto"
                                VerticalAlignment="Center"/>

                        </StackPanel>

                    </RadioButton>


                    <!-- ELIMINAR -->

                    <RadioButton
                        x:Name="MenuEliminarProducto"
                        Style="{StaticResource BotonMenuAdmin}"
                        Checked="Menu_Checked">

                        <StackPanel
                            Orientation="Horizontal">

                            <TextBlock
                                Text="🗑"
                                FontSize="16"
                                Width="30"
                                Foreground="#EF5350"/>

                            <TextBlock
                                Text="Productos retirados"
                                VerticalAlignment="Center"/>

                        </StackPanel>

                    </RadioButton>


                    <Border
                        Height="1"
                        Background="#454545"
                        Margin="16,16,16,13"/>


                    <!-- EMPLEADOS -->

                    <RadioButton
                        x:Name="MenuEmpleados"
                        Style="{StaticResource BotonMenuAdmin}"
                        Checked="Menu_Checked">

                        <StackPanel
                            Orientation="Horizontal">

                            <TextBlock
                                Text="👥"
                                FontSize="16"
                                Width="30"/>

                            <TextBlock
                                Text="Empleados"
                                VerticalAlignment="Center"/>

                        </StackPanel>

                    </RadioButton>


                    <!-- REPORTES -->

                    <RadioButton
                        x:Name="MenuReportes"
                        Style="{StaticResource BotonMenuAdmin}"
                        Checked="Menu_Checked">

                        <StackPanel
                            Orientation="Horizontal">

                            <TextBlock
                                Text="▥"
                                FontSize="18"
                                Width="30"
                                Foreground="{StaticResource AmarilloRefaccionaria}"/>

                            <TextBlock
                                Text="Reportes de ventas"
                                VerticalAlignment="Center"/>

                        </StackPanel>

                    </RadioButton>

                </StackPanel>


                <!-- ================================================= -->
                <!-- RESUMEN INVENTARIO -->
                <!-- ================================================= -->

                <Border
                    Grid.Row="1"
                    Margin="12,0,12,16"
                    Padding="16"
                    Background="#242424"
                    CornerRadius="8"
                    BorderBrush="#444444"
                    BorderThickness="1">

                    <StackPanel>

                        <TextBlock
                            Text="RESUMEN DEL ALMACÉN"
                            FontSize="10"
                            FontWeight="Bold"
                            Foreground="{StaticResource AmarilloRefaccionaria}"
                            Margin="0,0,0,13"/>


                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>

                            </Grid.RowDefinitions>


                            <StackPanel
                                Grid.Column="0"
                                Grid.Row="0">

                                <TextBlock
                                    Text="PRODUCTOS"
                                    FontSize="9"
                                    Foreground="#888888"/>

                                <TextBlock
                                    x:Name="TxtResumenPiezas"
                                    Text="0"
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Foreground="White"/>

                            </StackPanel>


                            <StackPanel
                                Grid.Column="1"
                                Grid.Row="0">

                                <TextBlock
                                    Text="UNIDADES"
                                    FontSize="9"
                                    Foreground="#888888"/>

                                <TextBlock
                                    x:Name="TxtResumenUnidades"
                                    Text="0"
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Foreground="White"/>

                            </StackPanel>


                            <StackPanel
                                Grid.Column="0"
                                Grid.Row="1"
                                Margin="0,10,0,0">

                                <TextBlock
                                    Text="MARCAS"
                                    FontSize="9"
                                    Foreground="#888888"/>

                                <TextBlock
                                    x:Name="TxtResumenMarcas"
                                    Text="0"
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Foreground="White"/>

                            </StackPanel>


                            <StackPanel
                                Grid.Column="1"
                                Grid.Row="1"
                                Margin="0,10,0,0">

                                <TextBlock
                                    Text="STOCK BAJO"
                                    FontSize="9"
                                    Foreground="#888888"/>

                                <TextBlock
                                    x:Name="TxtResumenResurtir"
                                    Text="0"
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource AmarilloRefaccionaria}"/>

                            </StackPanel>

                        </Grid>


                        <Border
                            Margin="0,14,0,0"
                            Padding="0,12,0,0"
                            BorderBrush="#444444"
                            BorderThickness="0,1,0,0">

                            <StackPanel>

                                <TextBlock
                                    Text="VALOR DEL INVENTARIO"
                                    FontSize="9"
                                    Foreground="#888888"/>

                                <TextBlock
                                    x:Name="TxtResumenValor"
                                    Text="$0.00"
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource AmarilloRefaccionaria}"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </Border>

            </Grid>


            <!-- ===================================================== -->
            <!-- ÁREA PRINCIPAL -->
            <!-- ===================================================== -->

            <Border
                Grid.Column="1"
                Background="{StaticResource GrisFondo}"
                Padding="30,26"
                RequestedTheme="Light">

                <Grid>


                    <!-- ================================================= -->
                    <!-- INVENTARIO -->
                    <!-- ================================================= -->

                    <Grid
                        x:Name="VistaInventario">

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="*"/>

                        </Grid.RowDefinitions>


                        <!-- ENCABEZADO -->

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>


                            <StackPanel>

                                <TextBlock
                                    Text="Inventario"
                                    FontSize="30"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource GrisMuyOscuro}"/>

                                <TextBlock
                                    x:Name="TxtResultado"
                                    Text="Todas las refacciones disponibles"
                                    FontSize="13"
                                    Foreground="{StaticResource GrisTexto}"
                                    Margin="0,3,0,0"/>

                            </StackPanel>


                            <Button
                                Grid.Column="1"
                                Content="+  NUEVO PRODUCTO"
                                Style="{StaticResource BotonAmarillo}"
                                Click="NuevoProducto_Click"
                                VerticalAlignment="Center"/>

                        </Grid>


                        <!-- ================================================= -->
                        <!-- TARJETAS DE RESUMEN -->
                        <!-- ================================================= -->

                        <Grid
                            Grid.Row="1"
                            Margin="0,22,0,18">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <!-- PRODUCTOS -->

                            <Border
                                Grid.Column="0"
                                Style="{StaticResource TarjetaResumen}">

                                <StackPanel>

                                    <TextBlock
                                        Text="PRODUCTOS"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Foreground="#888888"/>

                                    <TextBlock
                                        x:Name="TxtCardProductos"
                                        Text="0"
                                        FontSize="27"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource RojoRefaccionaria}"
                                        Margin="0,3,0,0"/>

                                </StackPanel>

                            </Border>


                            <!-- UNIDADES -->

                            <Border
                                Grid.Column="1"
                                Style="{StaticResource TarjetaResumen}">

                                <StackPanel>

                                    <TextBlock
                                        Text="UNIDADES EN ALMACÉN"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Foreground="#888888"/>

                                    <TextBlock
                                        x:Name="TxtCardUnidades"
                                        Text="0"
                                        FontSize="27"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource GrisMuyOscuro}"
                                        Margin="0,3,0,0"/>

                                </StackPanel>

                            </Border>


                            <!-- STOCK BAJO -->

                            <Border
                                Grid.Column="2"
                                Style="{StaticResource TarjetaResumen}"
                                BorderBrush="{StaticResource AmarilloRefaccionaria}"
                                BorderThickness="2">

                                <StackPanel>

                                    <TextBlock
                                        Text="STOCK BAJO"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Foreground="#888888"/>

                                    <TextBlock
                                        x:Name="TxtCardStockBajo"
                                        Text="0"
                                        FontSize="27"
                                        FontWeight="Bold"
                                        Foreground="#D89000"
                                        Margin="0,3,0,0"/>

                                </StackPanel>

                            </Border>


                            <!-- VALOR -->

                            <Border
                                Grid.Column="3"
                                Style="{StaticResource TarjetaResumen}">

                                <StackPanel>

                                    <TextBlock
                                        Text="VALOR INVENTARIO"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Foreground="#888888"/>

                                    <TextBlock
                                        x:Name="TxtCardValor"
                                        Text="$0.00"
                                        FontSize="24"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource RojoRefaccionaria}"
                                        Margin="0,4,0,0"/>

                                </StackPanel>

                            </Border>

                        </Grid>


                        <!-- ================================================= -->
                        <!-- BUSCADOR -->
                        <!-- ================================================= -->

                        <Grid
                            Grid.Row="2"
                            Margin="0,0,0,18">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="Auto"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>


                            <Border
                                Background="White"
                                CornerRadius="6"
                                BorderBrush="#CCCCCC"
                                BorderThickness="1">

                                <Grid>

                                    <TextBlock
                                        Text="⌕"
                                        FontSize="22"
                                        Margin="13,0,0,0"
                                        Foreground="#777777"
                                        VerticalAlignment="Center"/>

                                    <TextBox
                                        x:Name="TxtBuscar"
                                        Margin="45,0,10,0"
                                        Height="44"
                                        BorderThickness="0"
                                        FontSize="14"
                                        VerticalContentAlignment="Center"
                                        PlaceholderText="Buscar pieza, código, marca..."
                                        TextChanged="Buscar_TextChanged"/>

                                </Grid>

                            </Border>


                            <ToggleButton
                                x:Name="BotonFiltros"
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                Height="44"
                                Padding="16,0"
                                Checked="BotonFiltros_Cambio"
                                Unchecked="BotonFiltros_Cambio">

                                <StackPanel
                                    Orientation="Horizontal">

                                    <TextBlock
                                        Text="☰"
                                        Margin="0,0,7,0"/>

                                    <TextBlock
                                        x:Name="TxtBotonFiltros"
                                        Text="Filtros"/>

                                </StackPanel>

                            </ToggleButton>


                            <ComboBox
                                x:Name="CmbOrden"
                                Grid.Column="2"
                                Width="205"
                                Margin="10,0,0,0"
                                Height="44"
                                SelectedIndex="0"
                                SelectionChanged="Orden_SelectionChanged">

                                <ComboBoxItem
                                    Content="Ordenar por nombre"/>

                                <ComboBoxItem
                                    Content="Precio menor a mayor"/>

                                <ComboBoxItem
                                    Content="Precio mayor a menor"/>

                                <ComboBoxItem
                                    Content="Menos existencia"/>

                            </ComboBox>

                        </Grid>


                        <!-- ================================================= -->
                        <!-- FILTROS -->
                        <!-- ================================================= -->

                        <Border
                            x:Name="PanelFiltros"
                            Grid.Row="2"
                            Visibility="Collapsed"
                            Background="White"
                            CornerRadius="7"
                            Padding="18"
                            Margin="0,60,0,18"
                            BorderBrush="#D5D5D5"
                            BorderThickness="1">

                            <StackPanel>

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="230"/>

                                        <ColumnDefinition Width="230"/>

                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>


                                    <StackPanel>

                                        <TextBlock
                                            Text="Marca"
                                            FontWeight="SemiBold"
                                            FontSize="12"
                                            Margin="0,0,0,5"/>

                                        <ComboBox
                                            x:Name="CmbMarca"
                                            SelectionChanged="Marca_SelectionChanged"/>

                                    </StackPanel>


                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="15,0,0,0">

                                        <TextBlock
                                            Text="Modelo"
                                            FontWeight="SemiBold"
                                            FontSize="12"
                                            Margin="0,0,0,5"/>

                                        <ComboBox
                                            x:Name="CmbModelo"
                                            SelectionChanged="Filtro_Changed"/>

                                    </StackPanel>


                                    <Button
                                        Grid.Column="2"
                                        Content="Quitar filtros"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Padding="15,8"
                                        Click="LimpiarFiltros_Click"/>

                                </Grid>


                                <TextBlock
                                    Text="Tipo de pieza"
                                    FontWeight="SemiBold"
                                    FontSize="12"
                                    Margin="0,15,0,7"/>


                                <GridView
                                    x:Name="LstTipos"
                                    SelectionMode="Single"
                                    SelectionChanged="Filtro_Changed">

                                    <GridView.ItemTemplate>

                                        <DataTemplate
                                            x:DataType="x:String">

                                            <Border
                                                Background="#F3F3F3"
                                                CornerRadius="15"
                                                Padding="14,7"
                                                Margin="0,0,7,0">

                                                <TextBlock
                                                    Text="{x:Bind}"
                                                    FontSize="12"/>

                                            </Border>

                                        </DataTemplate>

                                    </GridView.ItemTemplate>

                                </GridView>

                            </StackPanel>

                        </Border>


                        <!-- ================================================= -->
                        <!-- TARJETAS DE REFACCIONES -->
                        <!-- ================================================= -->

                        <GridView
                            x:Name="ListaTarjetas"
                            Grid.Row="3"
                            SelectionMode="None"
                            IsItemClickEnabled="False">

                            <GridView.ItemsPanel>

                                <ItemsPanelTemplate>

                                    <ItemsWrapGrid
                                        Orientation="Horizontal"
                                        MaximumRowsOrColumns="4"/>

                                </ItemsPanelTemplate>

                            </GridView.ItemsPanel>


                            <GridView.ItemTemplate>

                                <DataTemplate
                                    x:DataType="models:Refaccion">

                                    <Border
                                        Style="{StaticResource TarjetaRefaccion}">

                                        <StackPanel>


                                            <!-- CÓDIGO + CATEGORÍA -->

                                            <Grid>

                                                <TextBlock
                                                    Text="{x:Bind Codigo, Mode=OneWay}"
                                                    FontSize="10"
                                                    FontWeight="SemiBold"
                                                    Foreground="#888888"/>

                                                <Border
                                                    HorizontalAlignment="Right"
                                                    Background="{StaticResource GrisMuyOscuro}"
                                                    CornerRadius="10"
                                                    Padding="9,3">

                                                    <TextBlock
                                                        Text="{x:Bind CategoriaNombre, Mode=OneWay}"
                                                        FontSize="9"
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource AmarilloRefaccionaria}"/>

                                                </Border>

                                            </Grid>


                                            <!-- NOMBRE -->

                                            <TextBlock
                                                Text="{x:Bind Nombre, Mode=OneWay}"
                                                FontSize="17"
                                                FontWeight="Bold"
                                                Foreground="{StaticResource GrisMuyOscuro}"
                                                TextWrapping="Wrap"
                                                Margin="0,14,0,4"/>


                                            <!-- MARCA -->

                                            <TextBlock
                                                Text="{x:Bind MarcaNombre, Mode=OneWay}"
                                                FontSize="12"
                                                Foreground="#777777"/>


                                            <!-- COMPATIBILIDAD -->

                                            <TextBlock
                                                Text="{x:Bind conv:Formato.Compatibilidad(EsUniversal, AutosDescripciones), Mode=OneWay}"
                                                FontSize="11"
                                                Foreground="#888888"
                                                TextWrapping="Wrap"
                                                MaxHeight="34"
                                                Margin="0,5,0,0"/>


                                            <!-- SEPARADOR -->

                                            <Border
                                                Height="1"
                                                Background="#E5E5E5"
                                                Margin="0,13,0,11"/>


                                            <!-- PRECIO + STOCK -->

                                            <Grid>

                                                <StackPanel>

                                                    <TextBlock
                                                        Text="PRECIO"
                                                        FontSize="9"
                                                        FontWeight="SemiBold"
                                                        Foreground="#999999"/>

                                                    <TextBlock
                                                        Text="{x:Bind conv:Formato.Moneda(Precio), Mode=OneWay}"
                                                        FontSize="21"
                                                        FontWeight="Bold"
                                                        Foreground="{StaticResource RojoRefaccionaria}"/>

                                                </StackPanel>


                                                <StackPanel
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">

                                                    <TextBlock
                                                        Text="EXISTENCIA"
                                                        FontSize="9"
                                                        FontWeight="SemiBold"
                                                        Foreground="#999999"
                                                        HorizontalAlignment="Right"/>

                                                    <TextBlock
                                                        Text="{x:Bind conv:Formato.Existencia(Stock), Mode=OneWay}"
                                                        FontSize="16"
                                                        FontWeight="Bold"
                                                        HorizontalAlignment="Right"/>

                                                </StackPanel>

                                            </Grid>


                                            <!-- ================================================= -->
                                            <!-- ESTADO STOCK -->
                                            <!-- ================================================= -->

                                            <Border
                                                Margin="0,12,0,0"
                                                CornerRadius="5"
                                                Padding="8,6"
                                                Background="#EEEEEE">

                                                <Grid>

                                                    <TextBlock
                                                        Text="{x:Bind conv:Formato.EstadoStock(Stock, StockBajo), Mode=OneWay}"
                                                        FontSize="11"
                                                        FontWeight="Bold"
                                                        HorizontalAlignment="Center"
                                                        Foreground="{x:Bind conv:Formato.ColorStock(StockBajo), Mode=OneWay}"/>

                                                </Grid>

                                            </Border>

                                        </StackPanel>

                                    </Border>

                                </DataTemplate>

                            </GridView.ItemTemplate>

                        </GridView>


                        <!-- SIN RESULTADOS -->

                        <StackPanel
                            x:Name="PanelSinResultados"
                            Grid.Row="3"
                            Visibility="Collapsed"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="No encontramos esa refacción"
                                FontSize="20"
                                FontWeight="Bold"
                                HorizontalAlignment="Center"
                                Foreground="{StaticResource GrisMuyOscuro}"/>

                            <TextBlock
                                Text="Prueba con otro nombre, código o marca."
                                Margin="0,6,0,15"
                                HorizontalAlignment="Center"
                                Foreground="#777777"/>

                            <Button
                                Content="Quitar filtros"
                                Padding="15,8"
                                Click="LimpiarFiltros_Click"/>

                        </StackPanel>

                    </Grid>


                    <!-- ================================================= -->
                    <!-- EDITAR PRODUCTO -->
                    <!-- ================================================= -->

                    <Grid
                        x:Name="VistaEditarProducto"
                        Visibility="Collapsed">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- ENCABEZADO -->

                        <StackPanel Margin="0,0,0,20">

                            <TextBlock
                                Text="Editar producto"
                                FontSize="30"
                                FontWeight="Bold"
                                Foreground="{StaticResource GrisMuyOscuro}"/>

                            <TextBlock
                                Text="Busca un producto del inventario y selecciona Editar."
                                FontSize="13"
                                Foreground="{StaticResource GrisTexto}"
                                Margin="0,3,0,0"/>

                        </StackPanel>


                        <!-- BUSCADOR -->

                        <Border
                            Grid.Row="1"
                            Background="White"
                            CornerRadius="7"
                            BorderBrush="#CCCCCC"
                            BorderThickness="1"
                            Margin="0,0,0,18">

                            <Grid>

                                <TextBlock
                                    Text="⌕"
                                    FontSize="22"
                                    Margin="13,0,0,0"
                                    Foreground="#777777"
                                    VerticalAlignment="Center"/>

                                <TextBox
                                    x:Name="TxtBuscarEditar"
                                    Margin="45,0,10,0"
                                    Height="44"
                                    BorderThickness="0"
                                    FontSize="14"
                                    VerticalContentAlignment="Center"
                                    PlaceholderText="Buscar por nombre, código, marca o categoría..."
                                    TextChanged="BuscarEditar_TextChanged"/>

                            </Grid>

                        </Border>


                        <!-- LISTA DE PRODUCTOS -->

                        <Grid Grid.Row="2">

                            <ListView
                                x:Name="ListaEditarProductos"
                                SelectionMode="None"
                                IsItemClickEnabled="False">

                                <ListView.ItemTemplate>

                                    <DataTemplate x:DataType="models:Refaccion">

                                        <Border
                                            Background="White"
                                            BorderBrush="#D8D8D8"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="18"
                                            Margin="0,0,0,12">

                                            <Grid>

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel>

                                                    <StackPanel
                                                        Orientation="Horizontal"
                                                        Spacing="10">

                                                        <TextBlock
                                                            Text="{x:Bind Codigo, Mode=OneWay}"
                                                            FontSize="11"
                                                            FontWeight="SemiBold"
                                                            Foreground="#888888"
                                                            VerticalAlignment="Center"/>

                                                        <Border
                                                            Background="{StaticResource GrisMuyOscuro}"
                                                            CornerRadius="10"
                                                            Padding="9,3">

                                                            <TextBlock
                                                                Text="{x:Bind CategoriaNombre, Mode=OneWay}"
                                                                FontSize="9"
                                                                FontWeight="SemiBold"
                                                                Foreground="{StaticResource AmarilloRefaccionaria}"/>

                                                        </Border>

                                                    </StackPanel>

                                                    <TextBlock
                                                        Text="{x:Bind Nombre, Mode=OneWay}"
                                                        FontSize="18"
                                                        FontWeight="Bold"
                                                        Foreground="{StaticResource GrisMuyOscuro}"
                                                        Margin="0,9,0,3"/>

                                                    <TextBlock
                                                        Text="{x:Bind MarcaNombre, Mode=OneWay}"
                                                        FontSize="12"
                                                        Foreground="#777777"/>

                                                    <StackPanel
                                                        Orientation="Horizontal"
                                                        Spacing="24"
                                                        Margin="0,9,0,0">

                                                        <TextBlock
                                                            Text="{x:Bind conv:Formato.Moneda(Precio), Mode=OneWay}"
                                                            FontSize="14"
                                                            FontWeight="SemiBold"
                                                            Foreground="{StaticResource RojoRefaccionaria}"/>

                                                        <TextBlock
                                                            Text="{x:Bind conv:Formato.Existencia(Stock), Mode=OneWay}"
                                                            FontSize="14"
                                                            FontWeight="SemiBold"
                                                            Foreground="{StaticResource GrisMuyOscuro}"/>

                                                    </StackPanel>

                                                </StackPanel>


                                                <Button
                                                    Grid.Column="1"
                                                    Content="EDITAR"
                                                    Tag="{x:Bind}"
                                                    Style="{StaticResource BotonAmarillo}"
                                                    VerticalAlignment="Center"
                                                    Margin="20,0,0,0"
                                                    Click="EditarProductoDesdeLista_Click"/>

                                            </Grid>

                                        </Border>

                                    </DataTemplate>

                                </ListView.ItemTemplate>

                            </ListView>


                            <StackPanel
                                x:Name="PanelSinProductosEditar"
                                Visibility="Collapsed"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                                <TextBlock
                                    Text="⌕"
                                    FontSize="42"
                                    HorizontalAlignment="Center"
                                    Foreground="#777777"/>

                                <TextBlock
                                    Text="No se encontraron productos"
                                    FontSize="20"
                                    FontWeight="Bold"
                                    HorizontalAlignment="Center"
                                    Foreground="{StaticResource GrisMuyOscuro}"/>

                                <TextBlock
                                    Text="Prueba con otro nombre, código, marca o categoría."
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Center"
                                    Foreground="#777777"/>

                            </StackPanel>

                        </Grid>

                    </Grid>


                    <!-- ================================================= -->
                    <!-- PRODUCTOS RETIRADOS -->
                    <!-- ================================================= -->

                    <Grid
                        x:Name="VistaProductosRetirados"
                        Visibility="Collapsed">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,0,0,20">

                            <TextBlock
                                Text="Productos retirados"
                                FontSize="30"
                                FontWeight="Bold"
                                Foreground="{StaticResource GrisMuyOscuro}"/>

                            <TextBlock
                                x:Name="TxtResumenRetirados"
                                Text="Productos retirados temporalmente del inventario."
                                FontSize="13"
                                Foreground="{StaticResource GrisTexto}"
                                Margin="0,3,0,0"/>

                        </StackPanel>

                        <Border
                            Grid.Row="1"
                            Background="#FFF8E1"
                            BorderBrush="{StaticResource AmarilloRefaccionaria}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="14"
                            Margin="0,0,0,18">

                            <TextBlock
                                Text="Estos productos no aparecen en el inventario normal. Puedes reactivarlos agregando existencia o eliminarlos definitivamente."
                                TextWrapping="Wrap"
                                Foreground="#555555"
                                FontSize="12"/>

                        </Border>

                        <Grid Grid.Row="2">

                            <GridView
                                x:Name="ListaProductosRetirados"
                                SelectionMode="None"
                                IsItemClickEnabled="False">

                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid
                                            Orientation="Horizontal"
                                            MaximumRowsOrColumns="4"/>
                                    </ItemsPanelTemplate>
                                </GridView.ItemsPanel>

                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="models:Refaccion">

                                        <Border Style="{StaticResource TarjetaRefaccion}">

                                            <StackPanel>

                                                <Grid>

                                                    <TextBlock
                                                        Text="{x:Bind Codigo, Mode=OneWay}"
                                                        FontSize="10"
                                                        FontWeight="SemiBold"
                                                        Foreground="#888888"/>

                                                    <Border
                                                        HorizontalAlignment="Right"
                                                        Background="{StaticResource GrisMuyOscuro}"
                                                        CornerRadius="10"
                                                        Padding="9,3">

                                                        <TextBlock
                                                            Text="{x:Bind CategoriaNombre, Mode=OneWay}"
                                                            FontSize="9"
                                                            FontWeight="SemiBold"
                                                            Foreground="{StaticResource AmarilloRefaccionaria}"/>

                                                    </Border>

                                                </Grid>

                                                <TextBlock
                                                    Text="{x:Bind Nombre, Mode=OneWay}"
                                                    FontSize="17"
                                                    FontWeight="Bold"
                                                    Foreground="{StaticResource GrisMuyOscuro}"
                                                    TextWrapping="Wrap"
                                                    Margin="0,14,0,4"/>

                                                <TextBlock
                                                    Text="{x:Bind MarcaNombre, Mode=OneWay}"
                                                    FontSize="12"
                                                    Foreground="#777777"/>

                                                <Border
                                                    Height="1"
                                                    Background="#E5E5E5"
                                                    Margin="0,13,0,11"/>

                                                <Grid>

                                                    <StackPanel>

                                                        <TextBlock
                                                            Text="EXISTENCIA"
                                                            FontSize="9"
                                                            FontWeight="SemiBold"
                                                            Foreground="#999999"/>

                                                        <TextBlock
                                                            Text="{x:Bind conv:Formato.Existencia(Stock), Mode=OneWay}"
                                                            FontSize="16"
                                                            FontWeight="Bold"
                                                            Foreground="{StaticResource GrisMuyOscuro}"/>

                                                    </StackPanel>

                                                    <StackPanel HorizontalAlignment="Right">

                                                        <TextBlock
                                                            Text="PRECIO"
                                                            FontSize="9"
                                                            FontWeight="SemiBold"
                                                            Foreground="#999999"
                                                            HorizontalAlignment="Right"/>

                                                        <TextBlock
                                                            Text="{x:Bind conv:Formato.Moneda(Precio), Mode=OneWay}"
                                                            FontSize="17"
                                                            FontWeight="Bold"
                                                            Foreground="{StaticResource RojoRefaccionaria}"/>

                                                    </StackPanel>

                                                </Grid>

                                                <Border
                                                    Margin="0,12,0,0"
                                                    Background="#FFEBEE"
                                                    BorderBrush="#EF9A9A"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    Padding="8,6">

                                                    <TextBlock
                                                        Text="PRODUCTO RETIRADO"
                                                        FontSize="11"
                                                        FontWeight="Bold"
                                                        Foreground="#B71C1C"
                                                        HorizontalAlignment="Center"/>

                                                </Border>

                                                <Button
                                                    Content="REACTIVAR / REABASTECER"
                                                    Tag="{x:Bind}"
                                                    Style="{StaticResource BotonAmarillo}"
                                                    HorizontalAlignment="Stretch"
                                                    Margin="0,14,0,0"
                                                    Click="ReactivarProducto_Click"/>

                                                <Button
                                                    Content="ELIMINAR DEFINITIVAMENTE"
                                                    Tag="{x:Bind}"
                                                    Style="{StaticResource BotonRojo}"
                                                    HorizontalAlignment="Stretch"
                                                    Margin="0,8,0,0"
                                                    Click="EliminarDefinitivamente_Click"/>

                                            </StackPanel>

                                        </Border>

                                    </DataTemplate>
                                </GridView.ItemTemplate>

                            </GridView>

                            <StackPanel
                                x:Name="PanelSinRetirados"
                                Visibility="Collapsed"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                                <TextBlock
                                    Text="✓"
                                    FontSize="42"
                                    HorizontalAlignment="Center"
                                    Foreground="#777777"/>

                                <TextBlock
                                    Text="No hay productos retirados"
                                    FontSize="20"
                                    FontWeight="Bold"
                                    HorizontalAlignment="Center"
                                    Foreground="{StaticResource GrisMuyOscuro}"/>

                                <TextBlock
                                    Text="Todos los productos se encuentran en el inventario."
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Center"
                                    Foreground="#777777"/>

                            </StackPanel>

                        </Grid>

                    </Grid>


                    <!-- ================================================= -->
                    <!-- EMPLEADOS -->
                    <!-- ================================================= -->

                    <Grid
                        x:Name="VistaEmpleados"
                        Visibility="Collapsed">

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="*"/>

                        </Grid.RowDefinitions>


                        <Grid Margin="0,0,0,20">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>


                            <StackPanel>

                                <TextBlock
                                    Text="Empleados"
                                    FontSize="30"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource GrisMuyOscuro}"/>

                                <TextBlock
                                    x:Name="TxtResumenEmpleados"
                                    Text="Personal registrado en el sistema"
                                    FontSize="13"
                                    Foreground="#777777"/>

                            </StackPanel>


                            <Button
                                Grid.Column="1"
                                Content="+  NUEVO EMPLEADO"
                                Style="{StaticResource BotonAmarillo}"
                                Click="NuevoEmpleado_Click"/>

                        </Grid>


                        <Border
                            Grid.Row="1"
                            Background="White"
                            BorderBrush="#D5D5D5"
                            BorderThickness="1"
                            CornerRadius="7">

                            <Grid>

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="48"/>

                                    <RowDefinition Height="*"/>

                                </Grid.RowDefinitions>


                                <Grid
                                    Background="{StaticResource GrisMuyOscuro}">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="170"/>

                                    </Grid.ColumnDefinitions>


                                    <TextBlock
                                        Grid.Column="0"
                                        Text="NOMBRE"
                                        Foreground="{StaticResource AmarilloRefaccionaria}"
                                        FontWeight="Bold"
                                        Margin="15,0"
                                        VerticalAlignment="Center"/>

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="USUARIO"
                                        Foreground="{StaticResource AmarilloRefaccionaria}"
                                        FontWeight="Bold"
                                        Margin="15,0"
                                        VerticalAlignment="Center"/>

                                    <TextBlock
                                        Grid.Column="2"
                                        Text="TELÉFONO"
                                        Foreground="{StaticResource AmarilloRefaccionaria}"
                                        FontWeight="Bold"
                                        Margin="15,0"
                                        VerticalAlignment="Center"/>

                                    <TextBlock
                                        Grid.Column="3"
                                        Text="ESTADO"
                                        Foreground="{StaticResource AmarilloRefaccionaria}"
                                        FontWeight="Bold"
                                        Margin="15,0"
                                        VerticalAlignment="Center"/>

                                    <TextBlock
                                        Grid.Column="4"
                                        Text="ACCIONES"
                                        Foreground="{StaticResource AmarilloRefaccionaria}"
                                        FontWeight="Bold"
                                        Margin="15,0"
                                        VerticalAlignment="Center"/>

                                </Grid>


                                <ListView
                                    x:Name="TablaEmpleados"
                                    Grid.Row="1"
                                    SelectionMode="Single"
                                    DoubleTapped="TablaEmpleados_DoubleTapped">

                                    <ListView.ItemTemplate>

                                        <DataTemplate
                                            x:DataType="models:Usuario">

                                            <Border
                                                BorderBrush="#E5E5E5"
                                                BorderThickness="0,0,0,1">

                                                <Grid
                                                    MinHeight="52">

                                                    <Grid.ColumnDefinitions>

                                                        <ColumnDefinition Width="2*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="200"/>

                                                    </Grid.ColumnDefinitions>


                                                    <TextBlock
                                                        Grid.Column="0"
                                                        Text="{x:Bind Nombre, Mode=OneWay}"
                                                        Margin="15,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="#222222"/>

                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Text="{x:Bind NombreUsuario, Mode=OneWay}"
                                                        Margin="15,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="#555555"/>

                                                    <TextBlock
                                                        Grid.Column="2"
                                                        Text="{x:Bind Telefono, Mode=OneWay}"
                                                        Margin="15,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="#555555"/>


                                                    <CheckBox
                                                        Grid.Column="3"
                                                        IsChecked="{x:Bind Activo, Mode=TwoWay}"
                                                        Content="{x:Bind conv:Formato.EstadoActivo(Activo), Mode=OneWay}"
                                                        Tag="{x:Bind}"
                                                        Click="InterruptorActivo_Click"
                                                        VerticalAlignment="Center"
                                                        Margin="15,0"/>


                                                    <StackPanel
                                                        Grid.Column="4"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Margin="10,0">

                                                        <Button
                                                            Content="Editar"
                                                            Tag="{x:Bind}"
                                                            Padding="12,6"
                                                            Click="EditarEmpleado_Click"/>

                                                        <Button
                                                            Content="Desactivar"
                                                            Tag="{x:Bind}"
                                                            Style="{StaticResource BotonRojo}"
                                                            Padding="12,6"
                                                            Margin="7,0,0,0"
                                                            Click="EliminarEmpleado_Click"/>

                                                    </StackPanel>

                                                </Grid>

                                            </Border>

                                        </DataTemplate>

                                    </ListView.ItemTemplate>

                                </ListView>

                            </Grid>

                        </Border>

                    </Grid>


                    <!-- ================================================= -->
                    <!-- REPORTES -->
                    <!-- ================================================= -->

                    <Grid
                        x:Name="VistaReportes"
                        Visibility="Collapsed">

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="*"/>

                        </Grid.RowDefinitions>


                        <!-- ENCABEZADO DE REPORTES -->
                        <Grid
                            Grid.Row="0"
                            Margin="0,0,0,20">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- TÍTULO Y DESCRIPCIÓN -->
                            <StackPanel
                                Grid.Column="0"
                                VerticalAlignment="Center">

                                <TextBlock
                                    Text="Reportes de ventas"
                                    FontSize="30"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource GrisMuyOscuro}"/>

                                <TextBlock
                                    Text="Consulta las ventas registradas en el sistema."
                                    FontSize="13"
                                    Foreground="#777777"/>

                            </StackPanel>

                            <!-- BOTÓN DESCARGAR REPORTE -->
                            <Button
                                Grid.Column="1"
                                Content="↓  DESCARGAR REPORTE"
                                Style="{StaticResource BotonAmarillo}"
                                MinWidth="190"
                                Height="42"
                                Padding="18,10"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="DescargarReporte_Click"/>

                        </Grid>


                        <!-- TARJETAS -->

                        <Grid
                            Grid.Row="1"
                            Margin="0,0,0,20">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <Border
                                Grid.Column="0"
                                Style="{StaticResource TarjetaResumen}">

                                <StackPanel>

                                    <TextBlock
                                        Text="TOTAL VENDIDO"
                                        FontSize="10"
                                        Foreground="#888888"/>

                                    <TextBlock
                                        x:Name="TxtRepTotal"
                                        Text="$0.00"
                                        FontSize="25"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource RojoRefaccionaria}"/>

                                    <TextBlock
                                        x:Name="TxtRepHoy"
                                        FontSize="11"
                                        Foreground="#888888"/>

                                </StackPanel>

                            </Border>


                            <Border
                                Grid.Column="1"
                                Style="{StaticResource TarjetaResumen}">

                                <StackPanel>

                                    <TextBlock
                                        Text="VENTAS REGISTRADAS"
                                        FontSize="10"
                                        Foreground="#888888"/>

                                    <TextBlock
                                        x:Name="TxtRepVentas"
                                        Text="0"
                                        FontSize="27"
                                        FontWeight="Bold"
                                        Foreground="#222222"/>

                                </StackPanel>

                            </Border>


                            <Border
                                Grid.Column="2"
                                Style="{StaticResource TarjetaResumen}">

                                <StackPanel>

                                    <TextBlock
                                        Text="PIEZAS VENDIDAS"
                                        FontSize="10"
                                        Foreground="#888888"/>

                                    <TextBlock
                                        x:Name="TxtRepPiezas"
                                        Text="0"
                                        FontSize="27"
                                        FontWeight="Bold"
                                        Foreground="#222222"/>

                                </StackPanel>

                            </Border>


                            <Border
                                Grid.Column="3"
                                Style="{StaticResource TarjetaResumen}">

                                <StackPanel>

                                    <TextBlock
                                        Text="PRODUCTO MÁS VENDIDO"
                                        FontSize="10"
                                        Foreground="#888888"/>

                                    <TextBlock
                                        x:Name="TxtRepTop"
                                        Text="—"
                                        FontSize="15"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource RojoRefaccionaria}"
                                        TextTrimming="CharacterEllipsis"
                                        Margin="0,5,0,0"/>

                                    <TextBlock
                                        x:Name="TxtRepTopDetalle"
                                        FontSize="11"
                                        Foreground="#888888"/>

                                </StackPanel>

                            </Border>

                        </Grid>


                        <!-- TABLA VENTAS -->

                        <Border
                            Grid.Row="2"
                            Background="White"
                            BorderBrush="#D5D5D5"
                            BorderThickness="1"
                            CornerRadius="7">

                            <Grid>

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="48"/>

                                    <RowDefinition Height="*"/>

                                </Grid.RowDefinitions>


                                <Grid
                                    Background="{StaticResource GrisMuyOscuro}">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="160"/>

                                    </Grid.ColumnDefinitions>


                                    <TextBlock
                                        Grid.Column="0"
                                        Text="FOLIO"
                                        Style="{StaticResource Etiqueta}"
                                        Margin="15,0"
                                        VerticalAlignment="Center"/>

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="FECHA"
                                        Style="{StaticResource Etiqueta}"
                                        Margin="15,0"
                                        VerticalAlignment="Center"/>

                                    <TextBlock
                                        Grid.Column="2"
                                        Text="MÉTODO DE PAGO"
                                        Style="{StaticResource Etiqueta}"
                                        Margin="15,0"
                                        VerticalAlignment="Center"/>

                                    <TextBlock
                                        Grid.Column="3"
                                        Text="TOTAL"
                                        Style="{StaticResource Etiqueta}"
                                        Margin="15,0"
                                        VerticalAlignment="Center"/>

                                    <TextBlock
                                        Grid.Column="4"
                                        Text="ACCIÓN"
                                        Style="{StaticResource Etiqueta}"
                                        Margin="15,0"
                                        VerticalAlignment="Center"/>

                                </Grid>


                                <ListView
                                    x:Name="TablaVentas"
                                    Grid.Row="1"
                                    SelectionMode="Single">

                                    <ListView.ItemTemplate>

                                        <DataTemplate
                                            x:DataType="models:Venta">

                                            <Border
                                                BorderBrush="#E5E5E5"
                                                BorderThickness="0,0,0,1">

                                                <Grid
                                                    MinHeight="52">

                                                    <Grid.ColumnDefinitions>

                                                        <ColumnDefinition Width="140"/>
                                                        <ColumnDefinition Width="170"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="160"/>

                                                    </Grid.ColumnDefinitions>


                                                    <TextBlock
                                                        Grid.Column="0"
                                                        Text="{x:Bind Folio, Mode=OneWay}"
                                                        Margin="15,0"
                                                        VerticalAlignment="Center"/>

                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Text="{x:Bind conv:Formato.Fecha(Fecha), Mode=OneWay}"
                                                        Margin="15,0"
                                                        VerticalAlignment="Center"/>

                                                    <TextBlock
                                                        Grid.Column="2"
                                                        Text="{x:Bind MetodoPago, Mode=OneWay}"
                                                        Margin="15,0"
                                                        VerticalAlignment="Center"/>

                                                    <TextBlock
                                                        Grid.Column="3"
                                                        Text="{x:Bind conv:Formato.Moneda(Total), Mode=OneWay}"
                                                        Margin="15,0"
                                                        VerticalAlignment="Center"
                                                        FontWeight="SemiBold"/>

                                                    <Button
                                                        Grid.Column="4"
                                                        Content="Ver Ticket"
                                                        Tag="{x:Bind}"
                                                        Style="{StaticResource BotonRojo}"
                                                        Padding="10,6"
                                                        Margin="10,0"
                                                        Click="VerTicketVenta_Click"/>

                                                </Grid>

                                            </Border>

                                        </DataTemplate>

                                    </ListView.ItemTemplate>

                                </ListView>

                            </Grid>

                        </Border>

                    </Grid>

                </Grid>

            </Border>

        </Grid>


        <!-- ========================================================= -->
        <!-- FORMULARIO FLOTANTE -->
        <!-- ========================================================= -->

        <Grid
            x:Name="Formulario"
            Grid.RowSpan="3"
            Background="#B0000000"
            Visibility="Collapsed">

            <Border
                Width="570"
                MaxHeight="720"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource GrisMuyOscuro}"
                CornerRadius="10"
                Padding="30"
                BorderBrush="{StaticResource AmarilloRefaccionaria}"
                BorderThickness="2">

                <ScrollViewer
                    VerticalScrollBarVisibility="Auto">

                    <StackPanel>


                        <TextBlock
                            x:Name="TxtTituloFormulario"
                            Text="Nuevo producto"
                            FontSize="25"
                            FontWeight="Bold"
                            Foreground="{StaticResource AmarilloRefaccionaria}"/>


                        <TextBlock
                            Text="Los campos marcados con * son obligatorios."
                            FontSize="12"
                            Foreground="#AAAAAA"
                            Margin="0,4,0,18"/>


                        <!-- ================================================= -->
                        <!-- PRODUCTO -->
                        <!-- ================================================= -->

                        <StackPanel
                            x:Name="CamposProducto">

                            <TextBlock
                                Text="Nombre de la pieza *"
                                Foreground="White"
                                FontWeight="SemiBold"/>

                            <TextBox
                                x:Name="TxtFormNombre"
                                Margin="0,5,0,10"
                                Height="44"
                                Background="#333333"
                                Foreground="White"
                                BorderBrush="#777777"
                                BorderThickness="0,0,0,1"
                                Padding="12,6"
                                VerticalContentAlignment="Center"
                                SelectionHighlightColor="#FFC107"/>


                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>

                                </Grid.RowDefinitions>


                                <StackPanel
                                    Grid.Column="0"
                                    Grid.Row="0"
                                    Margin="0,0,7,0">

                                    <TextBlock
                                        Text="Código *"
                                        Foreground="White"
                                        FontWeight="SemiBold"/>

                                    <TextBox
                                        x:Name="TxtFormCodigo"
                                        Margin="0,5,0,10"
                                        Height="44"
                                        Background="#333333"
                                        Foreground="White"
                                        BorderBrush="#777777"
                                        BorderThickness="0,0,0,1"
                                        Padding="12,6"
                                        VerticalContentAlignment="Center"
                                        SelectionHighlightColor="#FFC107"/>

                                </StackPanel>


                                <StackPanel
                                    Grid.Column="1"
                                    Grid.Row="0"
                                    Margin="7,0,0,0">

                                    <TextBlock
                                        Text="Categoría *"
                                        Foreground="White"
                                        FontWeight="SemiBold"/>

                                    <ComboBox
                                        x:Name="CmbFormCategoria"
                                        Margin="0,5,0,12"/>

                                </StackPanel>


                                <StackPanel
                                    Grid.Column="0"
                                    Grid.Row="1"
                                    Margin="0,0,7,0">

                                    <TextBlock
                                        Text="Marca *"
                                        Foreground="White"
                                        FontWeight="SemiBold"/>

                                    <ComboBox
                                        x:Name="CmbFormMarca"
                                        Margin="0,5,0,12"/>

                                </StackPanel>


                                <StackPanel
                                    Grid.Column="1"
                                    Grid.Row="1"
                                    Margin="7,0,0,0">

                                    <TextBlock
                                        Text="Precio *"
                                        Foreground="White"
                                        FontWeight="SemiBold"/>

                                    <TextBox
                                        x:Name="TxtFormPrecio"
                                        Margin="0,5,0,10"
                                        Height="44"
                                        Background="#333333"
                                        Foreground="White"
                                        BorderBrush="#777777"
                                        BorderThickness="0,0,0,1"
                                        Padding="12,6"
                                        VerticalContentAlignment="Center"
                                        SelectionHighlightColor="#FFC107"/>

                                </StackPanel>


                                <StackPanel
                                    Grid.Column="0"
                                    Grid.Row="2"
                                    Margin="0,0,7,0">

                                    <TextBlock
                                        Text="Existencia *"
                                        Foreground="White"
                                        FontWeight="SemiBold"/>

                                    <TextBox
                                        x:Name="TxtFormStock"
                                        Margin="0,5,0,10"
                                        Height="44"
                                        Background="#333333"
                                        Foreground="White"
                                        BorderBrush="#777777"
                                        BorderThickness="0,0,0,1"
                                        Padding="12,6"
                                        VerticalContentAlignment="Center"
                                        SelectionHighlightColor="#FFC107"/>
                                </StackPanel>


                                <CheckBox
                                    x:Name="ChkFormUniversal"
                                    Grid.Column="1"
                                    Grid.Row="2"
                                    Content="Sirve para cualquier auto"
                                    Foreground="White"
                                    VerticalAlignment="Bottom"
                                    Margin="7,0,0,18"
                                    Click="Universal_Click"/>

                            </Grid>


                            <TextBlock
                                Text="Autos compatibles"
                                Foreground="White"
                                FontWeight="SemiBold"/>

                            <ScrollViewer
                                Height="130"
                                Margin="0,4,0,0"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">

                                <ItemsControl
                                    x:Name="LstFormAutos">

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:ModeloAuto">

                                            <CheckBox
                                                Content="{x:Bind DescripcionCompleta, Mode=OneWay}"
                                                Tag="{x:Bind Id, Mode=OneWay}"
                                                Foreground="White"
                                                Margin="4,1"
                                                MinHeight="26"
                                                VerticalContentAlignment="Center"
                                                Checked="AutoCompatible_Checked"
                                                Unchecked="AutoCompatible_Unchecked"/>

                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                            </ScrollViewer>
                        </StackPanel>


                        <!-- ================================================= -->
                        <!-- EMPLEADO -->
                        <!-- ================================================= -->

                        <StackPanel
                            x:Name="CamposEmpleado"
                            Visibility="Collapsed">

                            <TextBlock
                                Text="Nombre completo *"
                                Foreground="White"
                                FontWeight="SemiBold"/>

                            <TextBox
                                x:Name="TxtFormEmpNombre"
                                Margin="0,5,0,12"
                                Height="44"
                                Background="#333333"
                                Foreground="White"
                                BorderBrush="#777777"
                                BorderThickness="0,0,0,1"
                                Padding="12,10"/>


                            <TextBlock
                                Text="Teléfono"
                                Foreground="White"
                                FontWeight="SemiBold"/>

                            <TextBox
                                x:Name="TxtFormEmpTelefono"
                                Margin="0,5,0,12"
                                Height="44"
                                Background="#333333"
                                Foreground="White"
                                BorderBrush="#777777"
                                BorderThickness="0,0,0,1"
                                Padding="12,10"/>


                            <TextBlock
                                Text="Usuario *"
                                Foreground="White"
                                FontWeight="SemiBold"/>

                            <TextBox
                                x:Name="TxtFormEmpUsuario"
                                Margin="0,5,0,12"
                                Height="44"
                                Background="#333333"
                                Foreground="White"
                                BorderBrush="#777777"
                                BorderThickness="0,0,0,1"
                                Padding="12,10"/>


                            <TextBlock
                                Text="Contraseña *"
                                Foreground="White"
                                FontWeight="SemiBold"/>

                            <Grid
                                Margin="0,5,0,12"
                                Height="44">

                                <PasswordBox
                                    x:Name="TxtFormEmpPassword"
                                    Height="44"
                                    Background="#333333"
                                    Foreground="White"
                                    BorderBrush="#777777"
                                    BorderThickness="0,0,0,1"
                                    Padding="12,10,50,10"
                                    PasswordRevealMode="Hidden"/>

                                <Button
                                    x:Name="BtnVerPasswordEmpleado"
                                    Content="👁"
                                    Width="46"
                                    Height="44"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Padding="0"
                                    Margin="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="White"
                                    FontSize="16"
                                    Click="VerPasswordEmpleado_Click"/>

                            </Grid>

                            <CheckBox
                                x:Name="ChkFormEmpActivo"
                                Content="Empleado activo"
                                IsChecked="True"
                                Foreground="White"
                                Margin="0,4,0,0"/>

                        </StackPanel>


                        <!-- ================================================= -->
                        <!-- BOTONES -->
                        <!-- ================================================= -->

                        <Grid
                            Margin="0,22,0,0">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="Auto"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <Button
                                x:Name="BtnEliminarProducto"
                                Content="RETIRAR PRODUCTO"
                                Style="{StaticResource BotonRojo}"
                                Visibility="Collapsed"
                                Click="EliminarProductoDesdeFormulario_Click"/>


                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">

                                <Button
                                    Content="Cancelar"
                                    Padding="16,9"
                                    Margin="0,0,9,0"
                                    Click="CerrarFormulario_Click"/>

                                <Button
                                    x:Name="BtnGuardar"
                                    Content="GUARDAR"
                                    Style="{StaticResource BotonAmarillo}"
                                    Click="Guardar_Click"/>

                            </StackPanel>

                        </Grid>

                    </StackPanel>

                </ScrollViewer>

            </Border>

        </Grid>


        <!-- ========================================================= -->
        <!-- TICKET DE VENTA -->
        <!-- ========================================================= -->

        <Grid
            x:Name="PanelTicketVenta"
            Grid.RowSpan="3"
            Background="#B8000000"
            Visibility="Collapsed"
            Canvas.ZIndex="100">

            <Border
                Width="650"
                Height="720"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#1B1B1B"
                CornerRadius="12"
                BorderBrush="#353535"
                BorderThickness="1">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="55"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="65"/>
                    </Grid.RowDefinitions>

                    <!-- ================================================= -->
                    <!-- TÍTULO DE LA VENTANA -->
                    <!-- ================================================= -->

                    <Grid
                        Grid.Row="0"
                        Padding="22,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Text="Ticket de venta"
                            FontSize="21"
                            FontWeight="Bold"
                            Foreground="White"
                            VerticalAlignment="Center"/>

                        <Button
                            Grid.Column="1"
                            Content="✕"
                            Width="36"
                            Height="36"
                            Padding="0"
                            Background="Transparent"
                            Foreground="#CCCCCC"
                            BorderThickness="0"
                            FontSize="16"
                            VerticalAlignment="Center"
                            Click="CerrarTicket_Click"/>

                    </Grid>


                    <!-- ================================================= -->
                    <!-- PAPEL DEL TICKET -->
                    <!-- ================================================= -->

                    <Border
                        Grid.Row="1"
                        Width="540"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Stretch"
                        Background="#FFFEF8"
                        Padding="28,16,28,14">

                        <StackPanel>

                            <!-- ========================================= -->
                            <!-- EL PISTÓN -->
                            <!-- ========================================= -->

                            <TextBlock
                                Text="EL PISTÓN"
                                FontSize="31"
                                FontWeight="Bold"
                                Foreground="#C81920"
                                HorizontalAlignment="Center"/>

                            <Border
                                Width="330"
                                Height="4"
                                Background="#E8B72A"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,3"/>

                            <TextBlock
                                Text="R E F A C C I O N A R I A"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="#222222"
                                HorizontalAlignment="Center"/>


                            <!-- ========================================= -->
                            <!-- INFORMACIÓN DEL NEGOCIO -->
                            <!-- ========================================= -->

                            <TextBlock
                                Text="Av. Principal #123, Monterrey, N.L."
                                FontSize="11"
                                Foreground="#444444"
                                HorizontalAlignment="Center"
                                Margin="0,7,0,0"/>

                            <TextBlock
                                Text="Tel. 81 1234 5678"
                                FontSize="11"
                                Foreground="#444444"
                                HorizontalAlignment="Center"
                                Margin="0,1,0,5"/>


                            <!-- ========================================= -->
                            <!-- SEPARADOR -->
                            <!-- ========================================= -->

                            <Border
                                Height="1"
                                Background="#555555"
                                Margin="0,4,0,7"/>


                            <!-- ========================================= -->
                            <!-- TÍTULO DEL TICKET -->
                            <!-- ========================================= -->

                            <TextBlock
                                Text="TICKET DE VENTA"
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="#222222"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,8"/>


                            <!-- ========================================= -->
                            <!-- DATOS DE LA VENTA -->
                            <!-- ========================================= -->

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="145"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="23"/>
                                    <RowDefinition Height="23"/>
                                    <RowDefinition Height="23"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- FOLIO -->

                                <TextBlock
                                    Grid.Row="0"
                                    Text="Folio:"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Foreground="#222222"/>

                                <TextBlock
                                    x:Name="TxtTicketFolio"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    FontSize="11"
                                    Foreground="#222222"/>


                                <!-- FECHA -->

                                <TextBlock
                                    Grid.Row="1"
                                    Text="Fecha:"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Foreground="#222222"/>

                                <TextBlock
                                    x:Name="TxtTicketFecha"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    FontSize="11"
                                    Foreground="#222222"/>


                                <!-- MÉTODO -->

                                <TextBlock
                                    Grid.Row="2"
                                    Text="Método de pago:"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Foreground="#222222"/>

                                <TextBlock
                                    x:Name="TxtTicketMetodo"
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    FontSize="11"
                                    Foreground="#222222"/>


                                <!-- REFERENCIA -->

                                <TextBlock
                                    x:Name="LblTicketReferencia"
                                    Grid.Row="3"
                                    Text="Referencia:"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Foreground="#222222"
                                    Visibility="Collapsed"/>

                                <TextBlock
                                    x:Name="TxtTicketReferencia"
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    FontSize="11"
                                    Foreground="#222222"
                                    Visibility="Collapsed"/>

                            </Grid>


                            <!-- ========================================= -->
                            <!-- SEPARADOR -->
                            <!-- ========================================= -->

                            <Border
                                Height="1"
                                Background="#555555"
                                Margin="0,7,0,7"/>


                            <!-- ========================================= -->
                            <!-- ENCABEZADOS DE PRODUCTOS -->
                            <!-- ========================================= -->

                            <Grid
                                Background="#E8E8E8"
                                Padding="6,5">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Text="PRODUCTO"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="#222222"/>

                                <TextBlock
                                    Grid.Column="1"
                                    Text="CANT."
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="#222222"
                                    HorizontalAlignment="Center"/>

                                <TextBlock
                                    Grid.Column="2"
                                    Text="P. UNIT."
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="#222222"
                                    HorizontalAlignment="Right"/>

                                <TextBlock
                                    Grid.Column="3"
                                    Text="IMPORTE"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="#222222"
                                    HorizontalAlignment="Right"/>

                            </Grid>


                            <!-- ========================================= -->
                            <!-- PRODUCTOS -->
                            <!-- ========================================= -->

                            <StackPanel
                                x:Name="PanelTicketProductos"
                                Margin="0,2,0,0"/>


                            <!-- ========================================= -->
                            <!-- SEPARADOR -->
                            <!-- ========================================= -->

                            <Border
                                Height="1"
                                Background="#555555"
                                Margin="0,6,0,6"/>


                            <!-- ========================================= -->
                            <!-- SUBTOTAL -->
                            <!-- ========================================= -->

                            <Grid Margin="0,1">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Text="Subtotal:"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="#222222"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,15,0"/>

                                <TextBlock
                                    x:Name="TxtTicketSubtotal"
                                    Grid.Column="1"
                                    FontSize="11"
                                    Foreground="#222222"
                                    HorizontalAlignment="Right"/>

                            </Grid>


                            <!-- ========================================= -->
                            <!-- IVA -->
                            <!-- ========================================= -->

                            <Grid Margin="0,1">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Text="IVA (16%):"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="#222222"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,15,0"/>

                                <TextBlock
                                    x:Name="TxtTicketIva"
                                    Grid.Column="1"
                                    FontSize="11"
                                    Foreground="#222222"
                                    HorizontalAlignment="Right"/>

                            </Grid>


                            <!-- ========================================= -->
                            <!-- TOTAL -->
                            <!-- ========================================= -->

                            <Border
                                Background="#E7E7E7"
                                Margin="0,5,0,5"
                                Padding="7,5">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Text="TOTAL:"
                                        FontSize="18"
                                        FontWeight="Bold"
                                        Foreground="#222222"
                                        HorizontalAlignment="Right"
                                        Margin="0,0,20,0"/>

                                    <TextBlock
                                        x:Name="TxtTicketTotal"
                                        Grid.Column="1"
                                        FontSize="19"
                                        FontWeight="Bold"
                                        Foreground="#222222"/>

                                </Grid>

                            </Border>


                            <!-- ========================================= -->
                            <!-- EFECTIVO -->
                            <!-- ========================================= -->

                            <StackPanel
                                x:Name="PanelTicketEfectivo">

                                <Border
                                    Height="1"
                                    Background="#555555"
                                    Margin="0,2,0,5"/>

                                <Grid Margin="0,1">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="145"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Text="Recibido:"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Foreground="#222222"/>

                                    <TextBlock
                                        x:Name="TxtTicketRecibido"
                                        Grid.Column="1"
                                        FontSize="11"
                                        Foreground="#222222"/>

                                </Grid>

                                <Grid Margin="0,1">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="145"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Text="Cambio:"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Foreground="#222222"/>

                                    <TextBlock
                                        x:Name="TxtTicketCambio"
                                        Grid.Column="1"
                                        FontSize="11"
                                        Foreground="#222222"/>

                                </Grid>

                            </StackPanel>


                            <!-- ========================================= -->
                            <!-- PIE -->
                            <!-- ========================================= -->

                            <Border
                                Height="1"
                                Background="#555555"
                                Margin="0,7,0,7"/>

                            <TextBlock
                                Text="¡GRACIAS POR SU COMPRA!"
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="#222222"
                                HorizontalAlignment="Center"/>

                            <TextBlock
                                Text="EL PISTÓN"
                                FontSize="10"
                                Foreground="#555555"
                                HorizontalAlignment="Center"
                                Margin="0,4,0,0"/>

                            <TextBlock
                                Text="TU REFACCIONARIA DE CONFIANZA"
                                FontSize="9"
                                Foreground="#666666"
                                HorizontalAlignment="Center"/>

                        </StackPanel>

                    </Border>


                    <!-- ================================================= -->
                    <!-- BOTÓN CERRAR -->
                    <!-- ================================================= -->

                    <Grid
                        Grid.Row="2"
                        Background="#151515"
                        Padding="20,10">

                        <Button
                            Content="CERRAR"
                            Width="190"
                            Height="42"
                            HorizontalAlignment="Right"
                            Background="#E51B23"
                            Foreground="White"
                            BorderThickness="0"
                            CornerRadius="6"
                            FontSize="14"
                            FontWeight="Bold"
                            Click="CerrarTicket_Click"/>

                    </Grid>

                </Grid>

            </Border>

        </Grid>
    </Grid>

</Page>



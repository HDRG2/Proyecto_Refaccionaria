<Page
    x:Class="Refaccionaria.Frontend.Views.VentaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Refaccionaria.Frontend.Converters"
    Background="#181818"
    FontFamily="Segoe UI">

    <!-- =========================================================
         RECURSOS
         ========================================================= -->
    <Page.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///style/VentaStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>


        <conv:StockBajoABrushConverter
            x:Key="BajoStockAColorConverter"/>

        <conv:TextoVacioAVisibilidadConverter
            x:Key="TextoVacioAVisibilidadConverter"/>


        <!-- =====================================================
             TARJETA DEL PRODUCTO
             ===================================================== -->

        <DataTemplate x:Key="TarjetaProducto">

            <Border
                Width="290"
                MinHeight="345"
                Margin="0,0,18,18"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="9"
                Padding="20">

                <Border.Shadow>

                    <ThemeShadow/>

                </Border.Shadow>

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>


                    <!-- CÓDIGO Y CATEGORÍA -->

                    <Grid Grid.Row="0">

                        <TextBlock
                            Text="{Binding Codigo}"
                            FontSize="11"
                            Foreground="#888888"
                            VerticalAlignment="Center"/>


                        <!-- CATEGORÍA AMARILLA -->

                        <Border
                            HorizontalAlignment="Right"
                            Background="{StaticResource Amarillo}"
                            CornerRadius="14"
                            Padding="12,4">

                            <TextBlock
                                Text="{Binding CategoriaNombre}"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="#202020"/>

                        </Border>

                    </Grid>


                    <!-- NOMBRE -->

                    <TextBlock
                        Grid.Row="1"
                        Text="{Binding Nombre}"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="#202020"
                        TextWrapping="Wrap"
                        Margin="0,16,0,0"/>


                    <!-- MARCA -->

                    <TextBlock
                        Grid.Row="2"
                        Text="{Binding MarcaNombre}"
                        FontSize="14"
                        Foreground="#606060"
                        Margin="0,4,0,0"/>


                    <!-- COMPATIBILIDAD -->

                    <TextBlock
                        Grid.Row="3"
                        Text="{Binding CompatibilidadTexto}"
                        FontSize="13"
                        Foreground="#777777"
                        TextWrapping="Wrap"
                        Margin="0,8,0,0"/>


                    <!-- SEPARADOR -->

                    <Border
                        Grid.Row="4"
                        Height="1"
                        Background="#E0E0E0"
                        Margin="0,18,0,18"/>


                    <!-- PRECIO Y EXISTENCIA -->

                    <Grid Grid.Row="5">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>


                        <StackPanel
                            Grid.Column="0">

                            <TextBlock
                                Text="PRECIO"
                                FontSize="10"
                                Foreground="#999999"/>

                            <TextBlock
                                Text="{Binding PrecioTexto}"
                                FontSize="23"
                                FontWeight="Bold"
                                Foreground="{StaticResource Rojo}"
                                Margin="0,3,0,0"/>

                        </StackPanel>


                        <StackPanel
                            Grid.Column="1"
                            HorizontalAlignment="Right">

                            <TextBlock
                                Text="EXISTENCIA"
                                FontSize="10"
                                Foreground="#999999"
                                HorizontalAlignment="Right"/>

                            <TextBlock
                                Text="{Binding ExistenciaTexto}"
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="#202020"
                                HorizontalAlignment="Right"
                                Margin="0,5,0,0"/>

                        </StackPanel>

                    </Grid>


                    <!-- AGREGAR -->

                    <Button
                        Grid.Row="6"
                        HorizontalAlignment="Stretch"
                        Margin="0,22,0,0"
                        Padding="14,12"
                        Style="{StaticResource BotonPrimario}"
                        Click="Agregar_Click">

                        <StackPanel
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">

                            <TextBlock
                                Text="&#x1F6D2;"
                                FontSize="17"
                                Margin="0,0,9,0"/>

                            <TextBlock
                                Text="Agregar"
                                FontSize="14"
                                FontWeight="Bold"/>

                        </StackPanel>

                    </Button>

                </Grid>

            </Border>

        </DataTemplate>


        <!-- =====================================================
             RENGLÓN DEL TICKET
             ===================================================== -->

        <DataTemplate x:Key="RenglonTicket">

            <Border
                Background="{StaticResource Campo}"
                BorderBrush="{StaticResource BordeSuave}"
                BorderThickness="1"
                CornerRadius="6"
                Margin="0,0,0,10">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <!-- LÍNEA ROJA IZQUIERDA -->

                    <Border
                        Grid.Column="0"
                        Background="{StaticResource Rojo}"
                        CornerRadius="6,0,0,6"/>


                    <!-- CONTENIDO -->

                    <Grid
                        Grid.Column="1"
                        Margin="14,12,12,12">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>


                        <!-- NOMBRE DEL PRODUCTO -->

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{Binding Refaccion.Nombre}"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="White"
                            TextWrapping="Wrap"
                            Margin="0,0,10,0"/>


                        <!-- QUITAR -->

                        <Button
                            Grid.Row="0"
                            Grid.Column="1"
                            Content="✕"
                            Style="{StaticResource BotonQuitar}"
                            VerticalAlignment="Top"
                            ToolTipService.ToolTip="Quitar del ticket"
                            Click="Quitar_Click"/>


                        <!-- CÓDIGO Y PRECIO -->

                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            Margin="0,5,0,0">

                            <TextBlock
                                Text="{Binding Refaccion.Codigo}"
                                FontSize="11"
                                Foreground="{StaticResource GrisTexto}"/>

                            <TextBlock
                                Text="  •  "
                                FontSize="11"
                                Foreground="#707070"/>

                            <TextBlock
                                Text="{Binding PrecioUnitarioTexto}"
                                FontSize="11"
                                Foreground="{StaticResource GrisTexto}"/>

                        </StackPanel>


                        <!-- CANTIDAD -->

                        <StackPanel
                            Grid.Row="2"
                            Grid.Column="0"
                            Orientation="Horizontal"
                            Margin="0,12,0,0">

                            <Button
                                Content="-"
                                Style="{StaticResource BotonCantidad}"
                                Click="Menos_Click"/>

                            <TextBlock
                                Text="{Binding Cantidad}"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Width="38"
                                TextAlignment="Center"
                                VerticalAlignment="Center"/>

                            <Button
                                Content="+"
                                Style="{StaticResource BotonCantidad}"
                                Click="Mas_Click"/>

                        </StackPanel>


                        <!-- SUBTOTAL DEL PRODUCTO -->

                        <StackPanel
                            Grid.Row="2"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="10,12,0,0">

                            <TextBlock
                                Text="SUBTOTAL"
                                FontSize="9"
                                Foreground="{StaticResource GrisTexto}"
                                HorizontalAlignment="Right"/>

                            <TextBlock
                                Text="{Binding ImporteTexto}"
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="White"
                                HorizontalAlignment="Right"
                                Margin="0,2,0,0"/>

                        </StackPanel>

                    </Grid>

                </Grid>

            </Border>

        </DataTemplate>


        </ResourceDictionary>
    </Page.Resources>



    <!-- =========================================================
         PANTALLA
         ========================================================= -->

    <Grid
        RequestedTheme="Dark"
        Background="{StaticResource Fondo}">

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>


        <!-- =====================================================
             PANEL DEL TICKET
             ===================================================== -->

        <Border
            x:Name="PanelTicket"
            Grid.Column="0"
            Width="0"
            Background="{StaticResource PanelOscuro}"
            BorderBrush="{StaticResource BordeSuave}"
            BorderThickness="0,0,1,0">

            <Grid Width="380">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <!-- CABECERA TICKET -->

                <Border
                    Grid.Row="0"
                    Background="{StaticResource Rojo}"
                    Padding="18,16">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Text="&#x1F6D2;"
                            FontSize="22"
                            Foreground="White"
                            VerticalAlignment="Center"/>

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">

                            <TextBlock
                                Text="Ticket de venta"
                                FontSize="17"
                                FontWeight="Bold"
                                Foreground="White"/>

                            <TextBlock
                                x:Name="TxtPiezas"
                                FontSize="12"
                                Foreground="#FFD6DD"
                                Margin="0,2,0,0"/>

                        </StackPanel>

                        <Button
                            Grid.Column="2"
                            Content="&#x2715;"
                            Style="{StaticResource BotonCerrarPanel}"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="Cerrar el ticket"
                            Click="CerrarTicket_Click"/>

                    </Grid>

                </Border>


                <!-- PRODUCTOS TICKET -->

                <Grid Grid.Row="1">

                    <ScrollViewer
                        VerticalScrollBarVisibility="Auto"
                        Padding="14,14,14,0">

                        <ItemsControl
                            x:Name="ListaTicket"
                            ItemTemplate="{StaticResource RenglonTicket}"/>

                    </ScrollViewer>


                    <StackPanel
                        x:Name="TxtTicketVacio"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">

                        <Border
                            Background="{StaticResource Campo}"
                            BorderBrush="{StaticResource BordeSuave}"
                            BorderThickness="1"
                            CornerRadius="40"
                            Width="80"
                            Height="80"
                            HorizontalAlignment="Center">

                            <TextBlock
                                Text="&#x1F6D2;"
                                FontSize="32"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource GrisTexto}"/>

                        </Border>

                        <TextBlock
                            Text="El carrito está vacío"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="White"
                            HorizontalAlignment="Center"
                            Margin="0,14,0,0"/>

                        <TextBlock
                            Text="Busca una pieza y presiona «Agregar»."
                            FontSize="12"
                            Foreground="{StaticResource GrisTexto}"
                            TextWrapping="Wrap"
                            TextAlignment="Center"
                            MaxWidth="220"
                            Margin="0,5,0,0"/>

                    </StackPanel>

                </Grid>


                <!-- TOTALES -->

                <Border
                    Grid.Row="2"
                    Background="{StaticResource Superficie}"
                    BorderBrush="{StaticResource BordeSuave}"
                    BorderThickness="0,1,0,0"
                    Padding="16,14">

                    <StackPanel>

                        <Grid Margin="0,0,0,5">

                            <TextBlock
                                Text="Subtotal"
                                FontSize="12"
                                Foreground="{StaticResource GrisTexto}"/>

                            <TextBlock
                                x:Name="TxtSubtotal"
                                FontSize="12"
                                HorizontalAlignment="Right"
                                Foreground="{StaticResource GrisTexto}"/>

                        </Grid>

                        <Grid Margin="0,0,0,12">

                            <TextBlock
                                Text="IVA (16%)"
                                FontSize="12"
                                Foreground="{StaticResource GrisTexto}"/>

                            <TextBlock
                                x:Name="TxtIva"
                                FontSize="12"
                                HorizontalAlignment="Right"
                                Foreground="{StaticResource GrisTexto}"/>

                        </Grid>

                        <Border
                            Background="{StaticResource Negro}"
                            CornerRadius="5"
                            Padding="14,12">

                            <Grid>

                                <TextBlock
                                    Text="Total"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    VerticalAlignment="Center"/>

                                <TextBlock
                                    x:Name="TxtTotal"
                                    FontSize="24"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    HorizontalAlignment="Right"/>

                            </Grid>

                        </Border>

                        <Button
                            x:Name="BtnCobrar"
                            Content="COBRAR"
                            Style="{StaticResource BotonPrimario}"
                            HorizontalAlignment="Stretch"
                            FontSize="16"
                            Padding="18,13"
                            Margin="0,12,0,0"
                            Click="Cobrar_Click"/>

                        <Button
                            x:Name="BtnVaciar"
                            Content="Vaciar carrito"
                            Style="{StaticResource BotonContorno}"
                            HorizontalAlignment="Stretch"
                            Margin="0,8,0,0"
                            Click="Vaciar_Click"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>


        <!-- =====================================================
             ÁREA PRINCIPAL
             ===================================================== -->

        <Grid
            Grid.Column="1"
            Margin="24,18,24,18">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>


            <!-- =================================================
                 ENCABEZADO
                 ================================================= -->

            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <StackPanel
                    Grid.Column="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                    <!-- LOGO -->

                    <Border
                        Width="48"
                        Height="48"
                        Background="{StaticResource Rojo}"
                        CornerRadius="7">

                        <TextBlock
                            Text="⚙"
                            FontSize="27"
                            Foreground="White"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                    </Border>


                    <StackPanel
                        Margin="14,0,0,0"
                        VerticalAlignment="Center">

                        <TextBlock
                            Text="EL PISTÓN"
                            FontSize="21"
                            FontWeight="Bold"
                            Foreground="White"/>

                        <TextBlock
                            Text="SISTEMA DE VENTAS"
                            FontSize="10"
                            Foreground="#A0A0A0"/>

                    </StackPanel>


                    <Border
                        Width="1"
                        Height="45"
                        Background="#707070"
                        Margin="25,0,25,0"/>


                    <Border
                        Background="{StaticResource Rojo}"
                        Width="7"
                        Height="40"
                        Margin="0,0,15,0"/>

                    <TextBlock
                        Text="Ventas"
                        FontSize="30"
                        FontWeight="Bold"
                        Foreground="White"
                        VerticalAlignment="Center"/>

                </StackPanel>



                <!-- BOTONES SUPERIORES DERECHOS -->
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Spacing="8">

                    <!-- CERRAR SESIÓN -->
                    <Button
                        x:Name="BtnCerrarSesion"
                        Width="42"
                        Height="42"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="CerrarSesion_Click"
                        ToolTipService.ToolTip="Cerrar sesión">

                        <TextBlock
                            Text="↪"
                            FontSize="24"
                            FontWeight="SemiBold"
                            Foreground="White"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                    </Button>
                    <!-- CARRITO SUPERIOR -->

                    <Button
                        x:Name="BtnVerTicket"
                        Grid.Column="1"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="4"
                        Click="VerTicket_Click"
                        ToolTipService.ToolTip="Abrir ticket">

                        <Grid
                            Width="45"
                            Height="42">

                            <!-- CARRITO -->
                            <TextBlock
                                Text="🛒"
                                FontSize="25"
                                Foreground="White"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"/>

                            <!-- CONTADOR -->
                            <Border
                                Width="22"
                                Height="22"
                                Background="{StaticResource Rojo}"
                                CornerRadius="11"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top">

                                <TextBlock
                                    x:Name="TxtBotonTicket"
                                    Text="0"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                            </Border>

                        </Grid>

                    </Button>

                </StackPanel>

            </Grid>


            <!-- =================================================
                 BUSCADOR Y FILTROS
                 ================================================= -->

            <Border
                Grid.Row="1"
                Background="{StaticResource Superficie}"
                BorderBrush="{StaticResource BordeSuave}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16"
                Margin="0,18,0,14">

                <StackPanel>


                    <!-- BUSCADOR -->

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="230"/>

                        </Grid.ColumnDefinitions>


                        <Grid Grid.Column="0">

                            <TextBox
                                x:Name="TxtBuscar"
                                Style="{StaticResource CajaBusqueda}"
                                Height="48"
                                TextChanged="Buscar_TextChanged"/>

                            <TextBlock
                                Text="&#x1F50D;"
                                FontSize="17"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                IsHitTestVisible="False"/>

                            <TextBlock
                                Text="Busca por pieza, código, marca, modelo o año..."
                                Foreground="#9A9A9A"
                                FontSize="13"
                                Margin="48,0,0,0"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Visibility="{Binding Text, ElementName=TxtBuscar, Converter={StaticResource TextoVacioAVisibilidadConverter}}"/>

                        </Grid>


                        <ComboBox
                            x:Name="CmbOrden"
                            Grid.Column="1"
                            Style="{StaticResource Lista}"
                            Height="48"
                            Margin="12,0,0,0"
                            SelectedIndex="0"
                            SelectionChanged="Filtro_Changed">

                            <ComboBoxItem
                                Content="Ordenar por nombre"/>

                            <ComboBoxItem
                                Content="Precio: menor a mayor"/>

                            <ComboBoxItem
                                Content="Precio: mayor a menor"/>

                            <ComboBoxItem
                                Content="Más existencia primero"/>

                        </ComboBox>

                    </Grid>


                    <!-- MARCA MODELO QUITAR -->

                    <Grid Margin="0,14,0,0">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>

                        <ComboBox
                            x:Name="CmbMarca"
                            Grid.Column="0"
                            Style="{StaticResource Lista}"
                            Height="42"
                            SelectionChanged="Marca_Changed"/>

                        <ComboBox
                            x:Name="CmbModelo"
                            Grid.Column="1"
                            Style="{StaticResource Lista}"
                            Height="42"
                            Margin="10,0,0,0"
                            SelectionChanged="Filtro_Changed"/>

                        <Button
                            Grid.Column="3"
                            Content="Quitar filtros"
                            Style="{StaticResource BotonPrimario}"
                            Padding="18,10"
                            Click="QuitarFiltros_Click"/>

                    </Grid>


                    <!-- CATEGORÍAS -->

                    <VariableSizedWrapGrid
                        Orientation="Horizontal"
                        Margin="0,16,0,-6">

                        <RadioButton
                            x:Name="RbTodos"
                            Content="Todos"
                            Tag="Todos"
                            GroupName="Tipo"
                            Style="{StaticResource Pildora}"
                            IsChecked="True"
                            Checked="Tipo_Checked"/>

                        <RadioButton
                            Content="Motor"
                            Tag="Motor"
                            GroupName="Tipo"
                            Style="{StaticResource Pildora}"
                            Checked="Tipo_Checked"/>

                        <RadioButton
                            Content="Frenos"
                            Tag="Frenos"
                            GroupName="Tipo"
                            Style="{StaticResource Pildora}"
                            Checked="Tipo_Checked"/>

                        <RadioButton
                            Content="Suspensión"
                            Tag="Suspensión"
                            GroupName="Tipo"
                            Style="{StaticResource Pildora}"
                            Checked="Tipo_Checked"/>

                        <RadioButton
                            Content="Eléctrico"
                            Tag="Eléctrico"
                            GroupName="Tipo"
                            Style="{StaticResource Pildora}"
                            Checked="Tipo_Checked"/>

                        <RadioButton
                            Content="Filtros"
                            Tag="Filtros"
                            GroupName="Tipo"
                            Style="{StaticResource Pildora}"
                            Checked="Tipo_Checked"/>

                        <RadioButton
                            Content="Transmisión"
                            Tag="Transmisión"
                            GroupName="Tipo"
                            Style="{StaticResource Pildora}"
                            Checked="Tipo_Checked"/>

                        <RadioButton
                            Content="Enfriamiento"
                            Tag="Enfriamiento"
                            GroupName="Tipo"
                            Style="{StaticResource Pildora}"
                            Checked="Tipo_Checked"/>

                    </VariableSizedWrapGrid>

                </StackPanel>

            </Border>


            <!-- =================================================
                 CATÁLOGO BLANCO
                 ================================================= -->

            <Border
                Grid.Row="2"
                Background="{StaticResource BlancoCatalogo}"
                CornerRadius="10"
                Padding="20">

                <Grid>


                    <ScrollViewer
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">

                        <ItemsControl
                            x:Name="ListaRefacciones"
                            ItemTemplate="{StaticResource TarjetaProducto}">

                            <ItemsControl.ItemsPanel>

                                <ItemsPanelTemplate>

                                    <ItemsWrapGrid
                                        Orientation="Horizontal"/>

                                </ItemsPanelTemplate>

                            </ItemsControl.ItemsPanel>

                        </ItemsControl>

                    </ScrollViewer>


                    <!-- SIN RESULTADOS -->

                    <StackPanel
                        x:Name="TxtSinResultados"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">

                        <TextBlock
                            Text="🔧"
                            FontSize="44"
                            HorizontalAlignment="Center"
                            Opacity="0.25"/>

                        <TextBlock
                            Text="No se encontraron productos"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="#333333"
                            HorizontalAlignment="Center"
                            Margin="0,12,0,0"/>

                        <TextBlock
                            Text="Prueba con otra búsqueda o quita los filtros."
                            FontSize="13"
                            Foreground="#777777"
                            HorizontalAlignment="Center"
                            Margin="0,5,0,0"/>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>


        <!-- =====================================================
             CAPA DE COBRO
             ===================================================== -->

        <Grid
            x:Name="CapaCobro"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Background="#CC000000"
            Visibility="Collapsed">

            <Border
                Background="{StaticResource Fondo}"
                BorderBrush="{StaticResource Rojo}"
                BorderThickness="0,4,0,0"
                CornerRadius="8"
                Width="430"
                Padding="26"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <Grid>


                    <!-- =========================================
                         PANEL COBRO
                         ========================================= -->

                    <StackPanel
                        x:Name="PanelCobro">

                        <TextBlock
                            Text="Cobrar venta"
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="White"/>

                        <TextBlock
                            x:Name="TxtPiezasCobro"
                            FontSize="12"
                            Foreground="{StaticResource GrisTexto}"
                            Margin="0,2,0,0"/>


                        <Border
                            Background="{StaticResource Negro}"
                            CornerRadius="5"
                            Padding="16"
                            Margin="0,16,0,0">

                            <Grid>

                                <TextBlock
                                    Text="Total a pagar"
                                    FontSize="14"
                                    Foreground="White"
                                    VerticalAlignment="Center"/>

                                <TextBlock
                                    x:Name="TxtTotalCobro"
                                    FontSize="26"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    HorizontalAlignment="Right"/>

                            </Grid>

                        </Border>


                        <TextBlock
                            Text="¿Cómo va a pagar?"
                            Style="{StaticResource Etiqueta}"
                            Margin="0,18,0,8"/>


                        <StackPanel Orientation="Horizontal">

                            <RadioButton
                                x:Name="RbEfectivo"
                                Content="Efectivo"
                                GroupName="Pago"
                                Style="{StaticResource Pildora}"
                                IsChecked="True"
                                Checked="MetodoPago_Checked"/>

                            <RadioButton
                                x:Name="RbTarjeta"
                                Content="Tarjeta"
                                GroupName="Pago"
                                Style="{StaticResource Pildora}"
                                Checked="MetodoPago_Checked"/>

                        </StackPanel>


                        <!-- EFECTIVO -->

                        <StackPanel
                            x:Name="PanelEfectivo"
                            Margin="0,18,0,0">

                            <TextBlock
                                Text="¿Con cuánto paga?"
                                Style="{StaticResource Etiqueta}"/>

                            <TextBox
                                x:Name="TxtRecibido"
                                Style="{StaticResource CajaTexto}"
                                TextChanged="Recibido_TextChanged"/>

                            <TextBlock
                                x:Name="TxtCambio"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Margin="0,10,0,0"/>

                        </StackPanel>


                        <!-- TARJETA -->

                        <StackPanel
                            x:Name="PanelTarjeta"
                            Margin="0,18,0,0"
                            Visibility="Collapsed">

                            <Border
                                Background="{StaticResource Campo}"
                                BorderBrush="{StaticResource BordeSuave}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="14">

                                <TextBlock
                                    Text="Pasa la tarjeta en la terminal por el total indicado y confirma la venta cuando el pago sea aprobado."
                                    FontSize="13"
                                    Foreground="#CCCCCC"
                                    TextWrapping="Wrap"/>

                            </Border>

                        </StackPanel>


                        <!-- BOTONES -->

                        <Grid Margin="0,22,0,0">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <Button
                                Grid.Column="0"
                                Content="Cancelar"
                                Style="{StaticResource BotonSecundario}"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,6,0"
                                Click="CancelarCobro_Click"/>

                            <Button
                                x:Name="BtnConfirmar"
                                Grid.Column="1"
                                Content="Confirmar venta"
                                Style="{StaticResource BotonPrimario}"
                                HorizontalAlignment="Stretch"
                                FontSize="14"
                                Padding="14,10"
                                Margin="6,0,0,0"
                                Click="Confirmar_Click"/>

                        </Grid>

                    </StackPanel>


                    <!-- =========================================
                         VENTA EXITOSA
                         ========================================= -->

                    <StackPanel
                        x:Name="PanelExito"
                        Visibility="Collapsed">

                        <Border
                            Background="{StaticResource Rojo}"
                            Width="52"
                            Height="52"
                            CornerRadius="26"
                            HorizontalAlignment="Left">

                            <TextBlock
                                Text="&#x2713;"
                                FontSize="25"
                                FontWeight="Bold"
                                Foreground="White"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <TextBlock
                            Text="Venta registrada"
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="White"
                            Margin="0,14,0,0"/>

                        <TextBlock
                            x:Name="TxtDetalleExito"
                            FontSize="13"
                            Foreground="{StaticResource GrisTexto}"
                            TextWrapping="Wrap"
                            Margin="0,6,0,0"/>


                        <Border
                            Background="{StaticResource Campo}"
                            BorderBrush="{StaticResource BordeSuave}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="16"
                            Margin="0,16,0,0">

                            <StackPanel>

                                <Grid Margin="0,0,0,6">

                                    <TextBlock
                                        Text="Folio"
                                        FontSize="13"
                                        Foreground="{StaticResource GrisTexto}"/>

                                    <TextBlock
                                        x:Name="TxtFolio"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        HorizontalAlignment="Right"/>

                                </Grid>

                                <Grid Margin="0,0,0,6">

                                    <TextBlock
                                        Text="Forma de pago"
                                        FontSize="13"
                                        Foreground="{StaticResource GrisTexto}"/>

                                    <TextBlock
                                        x:Name="TxtMetodoExito"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        HorizontalAlignment="Right"/>

                                </Grid>

                                <Grid>

                                    <TextBlock
                                        Text="Cambio"
                                        FontSize="13"
                                        Foreground="{StaticResource GrisTexto}"/>

                                    <TextBlock
                                        x:Name="TxtCambioExito"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        HorizontalAlignment="Right"/>

                                </Grid>

                            </StackPanel>

                        </Border>

                        <Button
                            Content="Iniciar otra venta"
                            Style="{StaticResource BotonPrimario}"
                            HorizontalAlignment="Stretch"
                            FontSize="14"
                            Padding="14,11"
                            Margin="0,20,0,0"
                            Click="CerrarExito_Click"/>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Page>




<Page
    x:Class="Refaccionaria.Frontend.Views.VentaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Refaccionaria.Frontend.Converters"
    Background="#181818"
    FontFamily="Segoe UI">

    <!-- =========================================================
         RECURSOS
         ========================================================= -->
    <Page.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///style/VentaStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>


            <conv:StockBajoABrushConverter
                x:Key="BajoStockAColorConverter"/>

            <conv:TextoVacioAVisibilidadConverter
                x:Key="TextoVacioAVisibilidadConverter"/>


            <!-- =====================================================
             TARJETA DEL PRODUCTO
             ===================================================== -->

            <DataTemplate x:Key="TarjetaProducto">

                <Border
                    Width="290"
                    MinHeight="385"
                    Margin="20,0,20,16"
                    Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="20">

                    <Border.Shadow>

                        <ThemeShadow/>

                    </Border.Shadow>

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="62"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="62"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>

                        </Grid.RowDefinitions>


                        <!-- CÓDIGO Y CATEGORÍA -->

                        <Grid Grid.Row="0">

                            <TextBlock
                                Text="{Binding Codigo}"
                                FontSize="11"
                                Foreground="#888888"
                                VerticalAlignment="Center"/>


                            <!-- CATEGORÍA AMARILLA -->

                            <Border
                                HorizontalAlignment="Right"
                                Background="{StaticResource Amarillo}"
                                CornerRadius="14"
                                Padding="12,4">

                                <TextBlock
                                    Text="{Binding CategoriaNombre}"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Foreground="#202020"/>

                            </Border>

                        </Grid>


                        <!-- NOMBRE -->

                        <TextBlock
                            Grid.Row="1"
                            Text="{Binding Nombre}"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="#202020"
                            TextWrapping="Wrap"
                            MaxLines="2"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center"/>


                        <!-- MARCA -->

                        <TextBlock
                            Grid.Row="2"
                            Text="{Binding MarcaNombre}"
                            FontSize="14"
                            Foreground="#606060"
                            Margin="0,4,0,0"/>


                        <!-- COMPATIBILIDAD -->

                        <StackPanel
                            Grid.Row="3"
                            Margin="0,7,0,0">

                            <TextBlock
                                Text="AUTOS COMPATIBLES"
                                FontSize="9"
                                FontWeight="SemiBold"
                                Foreground="#999999"
                                Margin="0,0,0,4"/>

                            <ItemsControl
                                ItemsSource="{Binding AutosDescripciones}">

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>

                                        <TextBlock
                                            Text="{Binding}"
                                            FontSize="11"
                                            Foreground="#606060"
                                            TextTrimming="CharacterEllipsis"
                                            Margin="0,1,0,1"/>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </StackPanel>


                        <!-- SEPARADOR -->

                        <Border
                            Grid.Row="4"
                            Height="1"
                            Background="#E0E0E0"
                            Margin="0,18,0,18"/>


                        <!-- PRECIO Y EXISTENCIA -->

                        <Grid Grid.Row="5">

                            <Grid.ColumnDefinitions>


                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>


                            <StackPanel
                                Grid.Column="0">

                                <TextBlock
                                    Text="PRECIO"
                                    FontSize="10"
                                    Foreground="#999999"/>

                                <TextBlock
                                    Text="{Binding PrecioTexto}"
                                    FontSize="23"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource Rojo}"
                                    Margin="0,3,0,0"/>

                            </StackPanel>


                            <StackPanel
                                Grid.Column="1"
                                HorizontalAlignment="Right">

                                <TextBlock
                                    Text="EXISTENCIA"
                                    FontSize="10"
                                    Foreground="#999999"
                                    HorizontalAlignment="Right"/>

                                <TextBlock
                                    Text="{Binding ExistenciaTexto}"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Foreground="#202020"
                                    HorizontalAlignment="Right"
                                    Margin="0,5,0,0"/>

                            </StackPanel>

                        </Grid>


                        <!-- AGREGAR -->

                        <Button
                            Grid.Row="6"
                            HorizontalAlignment="Stretch"
                            Margin="0,22,0,0"
                            Padding="14,12"
                            Style="{StaticResource BotonPrimario}"
                            Click="Agregar_Click">

                            <StackPanel
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="9">

                                <Viewbox
                                    Width="20"
                                    Height="20">

                                    <Path
                                        Data="M2 3 H5 L7.5 16 H19 L22 7 H6 M8 11 H20 M12 7 V16 M17 7 V16 M8 20 A1.5 1.5 0 1 1 11 20 A1.5 1.5 0 1 1 8 20 M17 20 A1.5 1.5 0 1 1 20 20 A1.5 1.5 0 1 1 17 20"
                                        Stroke="White"
                                        StrokeThickness="1.8"
                                        StrokeLineJoin="Round"
                                        Fill="Transparent"
                                        Stretch="Uniform"/>

                                </Viewbox>

                                <TextBlock
                                    Text="Agregar"
                                    FontSize="14"
                                    FontWeight="Bold"/>

                            </StackPanel>

                        </Button>

                    </Grid>

                </Border>

            </DataTemplate>


            <!-- =====================================================
             RENGLÓN DEL TICKET
             ===================================================== -->

            <DataTemplate x:Key="RenglonTicket">

                <Border
                    Background="{StaticResource Campo}"
                    BorderBrush="{StaticResource BordeSuave}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="0,0,0,10">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>


                        <!-- LÍNEA ROJA IZQUIERDA -->

                        <Border
                            Grid.Column="0"
                            Background="{StaticResource Rojo}"
                            CornerRadius="6,0,0,6"/>


                        <!-- CONTENIDO -->

                        <Grid
                            Grid.Column="1"
                            Margin="14,12,12,12">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>


                            <!-- NOMBRE DEL PRODUCTO -->

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="{Binding Refaccion.Nombre}"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="White"
                                TextWrapping="Wrap"
                                Margin="0,0,10,0"/>


                            <!-- QUITAR -->

                            <Button
                                Grid.Row="0"
                                Grid.Column="1"
                                Content="✕"
                                Style="{StaticResource BotonQuitar}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,-6,-4,0"
                                ToolTipService.ToolTip="Quitar del ticket"
                                Click="Quitar_Click"/>


                            <!-- CÓDIGO Y PRECIO -->

                            <StackPanel
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Orientation="Horizontal"
                                Margin="0,5,0,0">

                                <TextBlock
                                    Text="{Binding Refaccion.Codigo}"
                                    FontSize="11"
                                    Foreground="{StaticResource GrisTexto}"/>

                                <TextBlock
                                    Text="  •  "
                                    FontSize="11"
                                    Foreground="#707070"/>

                                <TextBlock
                                    Text="{Binding PrecioUnitarioTexto}"
                                    FontSize="11"
                                    Foreground="{StaticResource GrisTexto}"/>

                            </StackPanel>


                            <!-- CANTIDAD -->

                            <StackPanel
                                Grid.Row="2"
                                Grid.Column="0"
                                Orientation="Horizontal"
                                Margin="0,12,0,0">

                                <Button
                                    Content="-"
                                    Style="{StaticResource BotonCantidad}"
                                    Click="Menos_Click"/>

                                <TextBlock
                                    Text="{Binding Cantidad}"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Width="38"
                                    TextAlignment="Center"
                                    VerticalAlignment="Center"/>

                                <Button
                                    Content="+"
                                    Style="{StaticResource BotonCantidad}"
                                    Click="Mas_Click"/>

                            </StackPanel>


                            <!-- SUBTOTAL DEL PRODUCTO -->

                            <StackPanel
                                Grid.Row="2"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="10,12,0,0">

                                <TextBlock
                                    Text="SUBTOTAL"
                                    FontSize="9"
                                    Foreground="{StaticResource GrisTexto}"
                                    HorizontalAlignment="Right"/>

                                <TextBlock
                                    Text="{Binding ImporteTexto}"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    HorizontalAlignment="Right"
                                    Margin="0,2,0,0"/>

                            </StackPanel>

                        </Grid>

                    </Grid>

                </Border>

            </DataTemplate>


        </ResourceDictionary>
    </Page.Resources>



    <!-- =========================================================
         PANTALLA
         ========================================================= -->

    <Grid
        RequestedTheme="Dark"
        Background="{StaticResource Fondo}">

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>


        <!-- =====================================================
             PANEL DEL TICKET
             ===================================================== -->

        <Border
            x:Name="PanelTicket"
            Grid.Column="0"
            Width="0"
            Background="{StaticResource PanelOscuro}"
            BorderBrush="{StaticResource BordeSuave}"
            BorderThickness="0,0,1,0">

            <Grid Width="380">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <!-- CABECERA TICKET -->

                <Border
                    Grid.Row="0"
                    Background="{StaticResource Rojo}"
                    Padding="18,16">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>

                        <Viewbox
                            Grid.Column="0"
                            Width="26"
                            Height="26"
                            VerticalAlignment="Center">

                            <Path
                                Data="M2 3 H5 L7.5 16 H19 L22 7 H6 M8 11 H20 M12 7 V16 M17 7 V16 M8 20 A1.5 1.5 0 1 1 11 20 A1.5 1.5 0 1 1 8 20 M17 20 A1.5 1.5 0 1 1 20 20 A1.5 1.5 0 1 1 17 20"
                                Stroke="White"
                                StrokeThickness="1.8"
                                StrokeLineJoin="Round"
                                Fill="Transparent"
                                Stretch="Uniform"/>

                        </Viewbox>

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">

                            <TextBlock
                                Text="Ticket de venta"
                                FontSize="17"
                                FontWeight="Bold"
                                Foreground="White"/>

                            <TextBlock
                                x:Name="TxtPiezas"
                                FontSize="12"
                                Foreground="#FFD6DD"
                                Margin="0,2,0,0"/>

                        </StackPanel>

                        <Button
                            Grid.Column="2"
                            Content="&#x2715;"
                            Style="{StaticResource BotonCerrarPanel}"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="Cerrar el ticket"
                            Click="CerrarTicket_Click"/>

                    </Grid>

                </Border>


                <!-- PRODUCTOS TICKET -->

                <Grid Grid.Row="1">

                    <ScrollViewer
                        VerticalScrollBarVisibility="Auto"
                        Padding="14,14,14,0">

                        <ItemsControl
                            x:Name="ListaTicket"
                            ItemTemplate="{StaticResource RenglonTicket}"/>

                    </ScrollViewer>


                    <StackPanel
                        x:Name="TxtTicketVacio"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">

                        <Border
                            Background="{StaticResource Campo}"
                            BorderBrush="{StaticResource BordeSuave}"
                            BorderThickness="1"
                            CornerRadius="40"
                            Width="80"
                            Height="80"
                            HorizontalAlignment="Center">

                            <Viewbox
                                Width="36"
                                Height="36"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                                <Path
                                    Data="M2 3 H5 L7.5 16 H19 L22 7 H6 M8 11 H20 M12 7 V16 M17 7 V16 M8 20 A1.5 1.5 0 1 1 11 20 A1.5 1.5 0 1 1 8 20 M17 20 A1.5 1.5 0 1 1 20 20 A1.5 1.5 0 1 1 17 20"
                                    Stroke="White"
                                    StrokeThickness="1.8"
                                    StrokeLineJoin="Round"
                                    Fill="Transparent"
                                    Stretch="Uniform"/>

                            </Viewbox>

                        </Border>

                        <TextBlock
                            Text="El carrito está vacío"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="White"
                            HorizontalAlignment="Center"
                            Margin="0,14,0,0"/>

                        <TextBlock
                            Text="Busca una pieza y presiona «Agregar»."
                            FontSize="12"
                            Foreground="{StaticResource GrisTexto}"
                            TextWrapping="Wrap"
                            TextAlignment="Center"
                            MaxWidth="220"
                            Margin="0,5,0,0"/>

                    </StackPanel>

                </Grid>


                <!-- TOTALES -->

                <Border
                    Grid.Row="2"
                    Background="{StaticResource Superficie}"
                    BorderBrush="{StaticResource BordeSuave}"
                    BorderThickness="0,1,0,0"
                    Padding="16,14">

                    <StackPanel>

                        <Grid Margin="0,0,0,5">

                            <TextBlock
                                Text="Subtotal"
                                FontSize="12"
                                Foreground="{StaticResource GrisTexto}"/>

                            <TextBlock
                                x:Name="TxtSubtotal"
                                FontSize="12"
                                HorizontalAlignment="Right"
                                Foreground="{StaticResource GrisTexto}"/>

                        </Grid>

                        <Grid Margin="0,0,0,12">

                            <TextBlock
                                Text="IVA (16%)"
                                FontSize="12"
                                Foreground="{StaticResource GrisTexto}"/>

                            <TextBlock
                                x:Name="TxtIva"
                                FontSize="12"
                                HorizontalAlignment="Right"
                                Foreground="{StaticResource GrisTexto}"/>

                        </Grid>

                        <Border
                            Background="{StaticResource Negro}"
                            CornerRadius="5"
                            Padding="14,12">

                            <Grid>

                                <TextBlock
                                    Text="Total"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    VerticalAlignment="Center"/>

                                <TextBlock
                                    x:Name="TxtTotal"
                                    FontSize="24"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    HorizontalAlignment="Right"/>

                            </Grid>

                        </Border>

                        <Button
                            x:Name="BtnCobrar"
                            Content="COBRAR"
                            Style="{StaticResource BotonPrimario}"
                            HorizontalAlignment="Stretch"
                            FontSize="16"
                            Padding="18,13"
                            Margin="0,12,0,0"
                            Click="Cobrar_Click"/>

                        <Button
                            x:Name="BtnVaciar"
                            Content="Vaciar carrito"
                            Style="{StaticResource BotonContorno}"
                            HorizontalAlignment="Stretch"
                            Margin="0,8,0,0"
                            Click="Vaciar_Click"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>


        <!-- =====================================================
             ÁREA PRINCIPAL
             ===================================================== -->

        <Grid
            Grid.Column="1"
            Margin="24,18,24,18">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>


            <!-- =================================================
                 ENCABEZADO
                 ================================================= -->

            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <StackPanel
                    Grid.Column="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                    <!-- LOGO -->

                    <Viewbox Width="42"
                             Height="42">
                        <Path
                            Data="M12 2 L14 2.5 L14.7 4.5 L16.7 5.4 L18.6 4.5 L20.5 6.4 L19.6 8.3 L20.5 10.3 L22.5 11 L22.5 13 L20.5 13.7 L19.6 15.7 L20.5 17.6 L18.6 19.5 L16.7 18.6 L14.7 19.5 L14 21.5 L10 21.5 L9.3 19.5 L7.3 18.6 L5.4 19.5 L3.5 17.6 L4.4 15.7 L3.5 13.7 L1.5 13 L1.5 11 L3.5 10.3 L4.4 8.3 L3.5 6.4 L5.4 4.5 L7.3 5.4 L9.3 4.5 L10 2.5 Z M15.5 12 A3.5 3.5 0 1 1 8.5 12 A3.5 3.5 0 1 1 15.5 12"
                            Stroke="White"
                            StrokeThickness="1.8"
                            StrokeLineJoin="Round"
                            Fill="Transparent"
                            Stretch="Uniform"/>
                    </Viewbox>

                    <StackPanel
                        Margin="14,0,0,0"
                        VerticalAlignment="Center">

                        <TextBlock
                            Text="EL PISTÓN"
                            FontSize="21"
                            FontWeight="Bold"
                            Foreground="White"/>

                        <TextBlock
                            Text="SISTEMA DE VENTAS"
                            FontSize="10"
                            Foreground="#A0A0A0"/>

                    </StackPanel>


                    <Border
                        Width="1"
                        Height="45"
                        Background="#707070"
                        Margin="25,0,25,0"/>


                    <Border
                        Background="{StaticResource Rojo}"
                        Width="7"
                        Height="40"
                        Margin="0,0,15,0"/>

                    <TextBlock
                        Text="Ventas"
                        FontSize="30"
                        FontWeight="Bold"
                        Foreground="White"
                        VerticalAlignment="Center"/>

                </StackPanel>



                <!-- BOTONES SUPERIORES DERECHOS -->
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Spacing="8">

                    <!-- CERRAR SESIÓN -->
                    <Button
                        x:Name="BtnCerrarSesion"
                        Width="42"
                        Height="42"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="CerrarSesion_Click"
                        ToolTipService.ToolTip="Cerrar sesión">

                        <TextBlock
                            Text="↪"
                            FontSize="24"
                            FontWeight="SemiBold"
                            Foreground="White"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                    </Button>
                    <!-- CARRITO SUPERIOR -->

                    <Button
                        x:Name="BtnVerTicket"
                        Grid.Column="1"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="4"
                        Click="VerTicket_Click"
                        ToolTipService.ToolTip="Abrir ticket">

                        <Grid
                            Width="45"
                            Height="42">

                            <!-- CARRITO -->
                            <Viewbox
                                Width="30"
                                Height="30"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom">

                                <Path
                                    Data="M2 3 H5 L7.5 16 H19 L22 7 H6 M8 11 H20 M12 7 V16 M17 7 V16 M8 20 A1.5 1.5 0 1 1 11 20 A1.5 1.5 0 1 1 8 20 M17 20 A1.5 1.5 0 1 1 20 20 A1.5 1.5 0 1 1 17 20"
                                    Stroke="White"
                                    StrokeThickness="1.8"
                                    StrokeLineJoin="Round"
                                    Fill="Transparent"
                                    Stretch="Uniform"/>
                            </Viewbox>
                            <!-- CONTADOR -->
                            <Border
                                Width="22"
                                Height="22"
                                Background="{StaticResource Rojo}"
                                CornerRadius="11"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top">

                                <TextBlock
                                    x:Name="TxtBotonTicket"
                                    Text="0"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                            </Border>

                        </Grid>

                    </Button>

                </StackPanel>

            </Grid>


            <!-- =================================================
                 BUSCADOR Y FILTROS
                 ================================================= -->

            <Border
                Grid.Row="1"
                Background="{StaticResource Superficie}"
                BorderBrush="{StaticResource BordeSuave}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16"
                Margin="0,18,0,14">

                <StackPanel>


                    <!-- BUSCADOR -->

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="230"/>

                        </Grid.ColumnDefinitions>


                        <Grid Grid.Column="0">

                            <TextBox
                                x:Name="TxtBuscar"
                                MaxLength="30"
                                Style="{StaticResource CajaBusqueda}"
                                Height="48"
                                TextChanged="Buscar_TextChanged"/>

                            <TextBlock
                                Text="&#x1F50D;"
                                FontSize="17"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                IsHitTestVisible="False"/>

                            <TextBlock
                                Text="Busca por pieza, código, marca, modelo o año..."
                                Foreground="#9A9A9A"
                                FontSize="13"
                                Margin="48,0,0,0"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Visibility="{Binding Text, ElementName=TxtBuscar, Converter={StaticResource TextoVacioAVisibilidadConverter}}"/>

                        </Grid>


                        <ComboBox
                            x:Name="CmbOrden"
                            Grid.Column="1"
                            Style="{StaticResource Lista}"
                            Height="48"
                            Margin="12,0,0,0"
                            SelectedIndex="0"
                            SelectionChanged="Filtro_Changed">

                            <ComboBoxItem
                                Content="Ordenar por nombre"/>

                            <ComboBoxItem
                                Content="Precio: menor a mayor"/>

                            <ComboBoxItem
                                Content="Precio: mayor a menor"/>

                            <ComboBoxItem
                                Content="Más existencia primero"/>

                        </ComboBox>

                    </Grid>
                    <!-- MARCA MODELO QUITAR -->

                    <Grid Margin="0,14,0,0">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>

                        <!-- MARCA -->
                        <ComboBox
                            x:Name="CmbMarca"
                            Grid.Column="0"
                            Style="{StaticResource Lista}"
                            Height="42"
                            SelectionChanged="Marca_Changed"/>

                        <!-- MODELO -->
                        <ComboBox
                            x:Name="CmbModelo"
                            Grid.Column="1"
                            Style="{StaticResource Lista}"
                            Height="42"
                            Margin="10,0,0,0"
                            SelectionChanged="Modelo_Changed"/>

                        <!-- AÑO -->
                        <ComboBox
                            x:Name="CmbAnio"
                            Grid.Column="2"
                            Style="{StaticResource Lista}"
                            Height="42"
                            Margin="10,0,0,0"
                            SelectionChanged="Filtro_Changed"/>

                        <!-- QUITAR FILTROS -->
                        <Button
                            Grid.Column="4"
                            Content="Quitar filtros"
                            Style="{StaticResource BotonPrimario}"
                            Padding="18,10"
                            Click="QuitarFiltros_Click"/>

                    </Grid>


                    <!-- CATEGORÍAS -->
                    <Grid Margin="0,16,0,-6"
                          ColumnSpacing="8"
                          RowSpacing="6">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- PRIMERA FILA -->

                        <RadioButton
                            Grid.Row="0"
                            Grid.Column="0"
                            x:Name="RbTodos"
                            Content="Todos"
                            Tag="Todos"
                            GroupName="Tipo"
                            Style="{StaticResource Pildora}"
                            HorizontalAlignment="Stretch"
                            IsChecked="True"
                            Checked="Tipo_Checked"/>

                        <RadioButton
                            Grid.Row="0"
                            Grid.Column="1"
                            Content="Aceites"
                            Tag="Aceites"
                            GroupName="Tipo"
                            Style="{StaticResource Pildora}"
                            HorizontalAlignment="Stretch"
                            Checked="Tipo_Checked"/>

                        <RadioButton
                            Grid.Row="0"
                            Grid.Column="2"
                            Content="Filtros"
                            Tag="Filtros"
                            GroupName="Tipo"
                            Style="{StaticResource Pildora}"
                            HorizontalAlignment="Stretch"
                            Checked="Tipo_Checked"/>

                        <RadioButton
                            Grid.Row="0"
                            Grid.Column="3"
                            Content="Frenos"
                            Tag="Frenos"
                            GroupName="Tipo"
                            Style="{StaticResource Pildora}"
                            HorizontalAlignment="Stretch"
                            Checked="Tipo_Checked"/>

                        <RadioButton
                            Grid.Row="0"
                            Grid.Column="4"
                            Content="Suspensión"
                            Tag="Suspensión"
                            GroupName="Tipo"
                            Style="{StaticResource Pildora}"
                            HorizontalAlignment="Stretch"
                            Checked="Tipo_Checked"/>

                        <RadioButton
                            Grid.Row="0"
                            Grid.Column="5"
                            Content="Dirección"
                            Tag="Dirección"
                            GroupName="Tipo"
                            Style="{StaticResource Pildora}"
                            HorizontalAlignment="Stretch"
                            Checked="Tipo_Checked"/>

                        <RadioButton
                            Grid.Row="0"
                            Grid.Column="6"
                            Content="Motor"
                            Tag="Motor"
                            GroupName="Tipo"
                            Style="{StaticResource Pildora}"
                            HorizontalAlignment="Stretch"
                            Checked="Tipo_Checked"/>

                        <RadioButton
                            Grid.Row="0"
                            Grid.Column="7"
                            Content="Transmisión"
                            Tag="Transmisión"
                            GroupName="Tipo"
                            Style="{StaticResource Pildora}"
                            HorizontalAlignment="Stretch"
                            Checked="Tipo_Checked"/>

                        <!-- SEGUNDA FILA -->

                        <RadioButton
                            Grid.Row="1"
                            Grid.Column="0"
                            Content="Sistema eléctrico"
                            Tag="Sistema eléctrico"
                            GroupName="Tipo"
                            Style="{StaticResource Pildora}"
                            HorizontalAlignment="Stretch"
                            Checked="Tipo_Checked"/>

                        <RadioButton
                            Grid.Row="1"
                            Grid.Column="1"
                            Content="Enfriamiento"
                            Tag="Enfriamiento"
                            GroupName="Tipo"
                            Style="{StaticResource Pildora}"
                            HorizontalAlignment="Stretch"
                            Checked="Tipo_Checked"/>

                        <RadioButton
                            Grid.Row="1"
                            Grid.Column="2"
                            Content="Encendido"
                            Tag="Encendido"
                            GroupName="Tipo"
                            Style="{StaticResource Pildora}"
                            HorizontalAlignment="Stretch"
                            Checked="Tipo_Checked"/>

                        <RadioButton
                            Grid.Row="1"
                            Grid.Column="3"
                            Content="Escape"
                            Tag="Escape"
                            GroupName="Tipo"
                            Style="{StaticResource Pildora}"
                            HorizontalAlignment="Stretch"
                            Checked="Tipo_Checked"/>

                        <RadioButton
                            Grid.Row="1"
                            Grid.Column="4"
                            Content="Iluminación"
                            Tag="Iluminación"
                            GroupName="Tipo"
                            Style="{StaticResource Pildora}"
                            HorizontalAlignment="Stretch"
                            Checked="Tipo_Checked"/>

                        <RadioButton
                            Grid.Row="1"
                            Grid.Column="5"
                            Content="Carrocería"
                            Tag="Carrocería"
                            GroupName="Tipo"
                            Style="{StaticResource Pildora}"
                            HorizontalAlignment="Stretch"
                            Checked="Tipo_Checked"/>

                        <RadioButton
                            Grid.Row="1"
                            Grid.Column="6"
                            Content="Accesorios"
                            Tag="Accesorios"
                            GroupName="Tipo"
                            Style="{StaticResource Pildora}"
                            HorizontalAlignment="Stretch"
                            Checked="Tipo_Checked"/>

                        <RadioButton
                            Grid.Row="1"
                            Grid.Column="7"
                            Content="Lubricantes"
                            Tag="Lubricantes"
                            GroupName="Tipo"
                            Style="{StaticResource Pildora}"
                            HorizontalAlignment="Stretch"
                            Checked="Tipo_Checked"/>

                    </Grid>

                </StackPanel>

            </Border>


            <!-- =================================================
                 CATÁLOGO BLANCO
                 ================================================= -->

            <Border
                Grid.Row="2"
                Background="{StaticResource BlancoCatalogo}"
                CornerRadius="10"
                Padding="20">

                <Grid>


                    <ScrollViewer
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">

                        <ItemsControl
                            x:Name="ListaRefacciones"
                            ItemTemplate="{StaticResource TarjetaProducto}"
                            HorizontalAlignment="Center">

                            <ItemsControl.ItemsPanel>

                                <ItemsPanelTemplate>

                                    <ItemsWrapGrid
                                        Orientation="Horizontal"
                                        MaximumRowsOrColumns="5"/>

                                </ItemsPanelTemplate>

                            </ItemsControl.ItemsPanel>

                        </ItemsControl>

                    </ScrollViewer>


                    <!-- SIN RESULTADOS -->

                    <StackPanel
                        x:Name="TxtSinResultados"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">

                        <TextBlock
                            Text="🔧"
                            FontSize="44"
                            HorizontalAlignment="Center"
                            Opacity="0.25"/>

                        <TextBlock
                            Text="No se encontraron productos"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="#333333"
                            HorizontalAlignment="Center"
                            Margin="0,12,0,0"/>

                        <TextBlock
                            Text="Prueba con otra búsqueda o quita los filtros."
                            FontSize="13"
                            Foreground="#777777"
                            HorizontalAlignment="Center"
                            Margin="0,5,0,0"/>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>


        <!-- =====================================================
             CAPA DE COBRO
             ===================================================== -->

        <Grid
            x:Name="CapaCobro"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Background="#CC000000"
            Visibility="Collapsed">

            <Border
                Background="{StaticResource Fondo}"
                BorderBrush="{StaticResource Rojo}"
                BorderThickness="0,4,0,0"
                CornerRadius="8"
                Width="430"
                Padding="26"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <Grid>


                    <!-- =========================================
                         PANEL COBRO
                         ========================================= -->

                    <StackPanel
                        x:Name="PanelCobro">

                        <TextBlock
                            Text="Cobrar venta"
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="White"/>

                        <TextBlock
                            x:Name="TxtPiezasCobro"
                            FontSize="12"
                            Foreground="{StaticResource GrisTexto}"
                            Margin="0,2,0,0"/>


                        <Border
                            Background="{StaticResource Negro}"
                            CornerRadius="5"
                            Padding="16"
                            Margin="0,16,0,0">

                            <Grid>

                                <TextBlock
                                    Text="Total a pagar"
                                    FontSize="14"
                                    Foreground="White"
                                    VerticalAlignment="Center"/>

                                <TextBlock
                                    x:Name="TxtTotalCobro"
                                    FontSize="26"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    HorizontalAlignment="Right"/>

                            </Grid>

                        </Border>


                        <TextBlock
                            Text="¿Cómo va a pagar?"
                            Style="{StaticResource Etiqueta}"
                            Margin="0,18,0,8"/>


                        <StackPanel Orientation="Horizontal">

                            <RadioButton
                                x:Name="RbEfectivo"
                                Content="Efectivo"
                                GroupName="Pago"
                                Style="{StaticResource Pildora}"
                                IsChecked="True"
                                Checked="MetodoPago_Checked"/>

                            <RadioButton
                                x:Name="RbTarjeta"
                                Content="Tarjeta"
                                GroupName="Pago"
                                Style="{StaticResource Pildora}"
                                Checked="MetodoPago_Checked"/>

                        </StackPanel>


                        <!-- EFECTIVO -->

                        <StackPanel
                            x:Name="PanelEfectivo"
                            Margin="0,18,0,0">

                            <TextBlock
                                Text="¿Con cuánto paga?"
                                Style="{StaticResource Etiqueta}"/>

                            <TextBox
                                x:Name="TxtRecibido"
                                MaxLength="10"
                                Style="{StaticResource CajaTexto}"
                                TextChanged="Recibido_TextChanged"/>

                            <TextBlock
                                x:Name="TxtCambio"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Margin="0,10,0,0"/>

                        </StackPanel>


                        <!-- TARJETA -->

                        <StackPanel
                            x:Name="PanelTarjeta"
                            Margin="0,18,0,0"
                            Visibility="Collapsed">

                            <Border
                                Background="{StaticResource Campo}"
                                BorderBrush="{StaticResource BordeSuave}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="14">

                                <TextBlock
                                    Text="Pasa la tarjeta en la terminal por el total indicado y confirma la venta cuando el pago sea aprobado."
                                    FontSize="13"
                                    Foreground="#CCCCCC"
                                    TextWrapping="Wrap"/>

                            </Border>

                        </StackPanel>


                        <!-- BOTONES -->

                        <Grid Margin="0,22,0,0">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <Button
                                Grid.Column="0"
                                Content="Cancelar"
                                Style="{StaticResource BotonSecundario}"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,6,0"
                                Click="CancelarCobro_Click"/>

                            <Button
                                x:Name="BtnConfirmar"
                                Grid.Column="1"
                                Content="Confirmar venta"
                                Style="{StaticResource BotonPrimario}"
                                HorizontalAlignment="Stretch"
                                FontSize="14"
                                Padding="14,10"
                                Margin="6,0,0,0"
                                Click="Confirmar_Click"/>

                        </Grid>

                    </StackPanel>


                    <!-- =========================================
                         VENTA EXITOSA
                    ========================================= -->

                    <StackPanel
                        x:Name="PanelExito"
                        Visibility="Collapsed">

                        <Border
                            Background="{StaticResource Rojo}"
                            Width="52"
                            Height="52"
                            CornerRadius="26"
                            HorizontalAlignment="Left">

                            <TextBlock
                                Text="&#x2713;"
                                FontSize="25"
                                FontWeight="Bold"
                                Foreground="White"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <TextBlock
                            Text="Venta registrada"
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="White"
                            Margin="0,14,0,0"/>

                        <TextBlock
                            x:Name="TxtDetalleExito"
                            FontSize="13"
                            Foreground="{StaticResource GrisTexto}"
                            TextWrapping="Wrap"
                            Margin="0,6,0,0"/>


                        <Border
                            Background="{StaticResource Campo}"
                            BorderBrush="{StaticResource BordeSuave}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="16"
                            Margin="0,16,0,0">

                            <StackPanel>

                                <Grid Margin="0,0,0,6">

                                    <TextBlock
                                        Text="Folio"
                                        FontSize="13"
                                        Foreground="{StaticResource GrisTexto}"/>

                                    <TextBlock
                                        x:Name="TxtFolio"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        HorizontalAlignment="Right"/>

                                </Grid>

                                <Grid Margin="0,0,0,6">

                                    <TextBlock
                                        Text="Forma de pago"
                                        FontSize="13"
                                        Foreground="{StaticResource GrisTexto}"/>

                                    <TextBlock
                                        x:Name="TxtMetodoExito"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        HorizontalAlignment="Right"/>

                                </Grid>

                                <Grid>

                                    <TextBlock
                                        Text="Cambio"
                                        FontSize="13"
                                        Foreground="{StaticResource GrisTexto}"/>

                                    <TextBlock
                                        x:Name="TxtCambioExito"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        HorizontalAlignment="Right"/>

                                </Grid>

                            </StackPanel>

                        </Border>

                        <Button
                            Content="Iniciar otra venta"
                            Style="{StaticResource BotonPrimario}"
                            HorizontalAlignment="Stretch"
                            FontSize="14"
                            Padding="14,11"
                            Margin="0,20,0,0"
                            Click="CerrarExito_Click"/>

                    </StackPanel>

                </Grid>

            </Border>
        </Grid>

        <!-- =====================================================
             ASISTENTE IA
             ===================================================== -->
        <StackPanel Grid.ColumnSpan="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,25,25"
                    Spacing="12"
                    Canvas.ZIndex="100">

            <!-- VENTANA DEL CHAT -->
            <Border x:Name="PanelChatbot"
                    Width="380"
                    Height="460"
                    Background="#FFFFFF"
                    BorderBrush="#D90429"
                    BorderThickness="2"
                    CornerRadius="14"
                    Visibility="Collapsed"
                    HorizontalAlignment="Right">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ENCABEZADO -->
                    <Border Grid.Row="0"
                            Background="#181818"
                            CornerRadius="12,12,0,0"
                            Padding="16,14">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Asistentencia virtual"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           FontSize="18"/>

                                <TextBlock Text="EL PISTÓN · Asistente de ventas"
                                           Foreground="#FFB7B7"
                                           FontSize="12"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Spacing="4">

                                <!-- NUEVA CONVERSACIÓN -->
                                <Button x:Name="BtnNuevaConversacion"
                                        Width="36"
                                        Height="36"
                                        Padding="0"
                                        Background="Transparent"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Click="NuevaConversacion_Click"
                                        ToolTipService.ToolTip="Nueva conversación">

                                    <FontIcon Glyph="&#xE70F;"
                                              FontFamily="Segoe MDL2 Assets"
                                              FontSize="17"/>

                                </Button>

                                <!-- CERRAR CHAT -->
                                <Button Content="✕"
                                        Width="36"
                                        Height="36"
                                        Padding="0"
                                        Background="Transparent"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Click="CerrarChatbot_Click"
                                        ToolTipService.ToolTip="Cerrar asistente"/>

                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- CONVERSACIÓN -->
                    <ScrollViewer x:Name="ScrollChatbot"
                                  Grid.Row="1"
                                  Background="#F5F5F5"
                                  Padding="14"
                                  VerticalScrollBarVisibility="Auto">

                        <StackPanel x:Name="PanelMensajes"
                                    Spacing="12">

                            <Border Background="#E5E5E5"
                                    CornerRadius="10"
                                    Padding="12"
                                    HorizontalAlignment="Left"
                                    MaxWidth="310">

                                <TextBlock
                                    Text="¡Hola! Soy el asistente de El Pistón. ¿En qué puedo ayudarte?"
                                    Foreground="#202020"
                                    TextWrapping="Wrap"
                                    FontSize="14"/>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- ÁREA PARA ESCRIBIR -->
                    <Grid Grid.Row="2"
                          Background="White"
                          Padding="12"
                          ColumnSpacing="8">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TxtMensajeChatbot"
                                 Grid.Column="0"
                                 Height="42"
                                 Background="White"
                                 Foreground="Black"
                                 BorderBrush="Black"
                                 BorderThickness="1"
                                 CornerRadius="0"
                                 PlaceholderText="Escribe tu pregunta..."
                                 PlaceholderForeground="#777777"
                                 VerticalContentAlignment="Center"
                                 AcceptsReturn="False"
                                 KeyDown="TxtMensajeChatbot_KeyDown">

                            <TextBox.Resources>
                                <SolidColorBrush x:Key="TextControlBackground"
                                                 Color="White"/>
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver"
                                                 Color="White"/>
                                <SolidColorBrush x:Key="TextControlBackgroundFocused"
                                                 Color="White"/>

                                <SolidColorBrush x:Key="TextControlForeground"
                                                 Color="Black"/>
                                <SolidColorBrush x:Key="TextControlForegroundPointerOver"
                                                 Color="Black"/>
                                <SolidColorBrush x:Key="TextControlForegroundFocused"
                                                 Color="Black"/>

                                <SolidColorBrush x:Key="TextControlBorderBrush"
                                                 Color="Black"/>
                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver"
                                                 Color="Black"/>
                                <SolidColorBrush x:Key="TextControlBorderBrushFocused"
                                                 Color="Black"/>
                            </TextBox.Resources>
                        </TextBox>

                        <Button x:Name="BtnEnviarChatbot"
                                Grid.Column="1"
                                Content="Enviar"
                                Click="EnviarChatbot_Click"
                                Background="#D90429"
                                Foreground="White"
                                BorderBrush="#D90429"
                                BorderThickness="0"
                                FontWeight="Bold"
                                Padding="14,8">

                            <Button.Resources>

                                <!-- Color normal -->
                                <SolidColorBrush
                                    x:Key="ButtonBackground"
                                    Color="#D90429"/>

                                <!-- Color al pasar el mouse -->
                                <SolidColorBrush
                                    x:Key="ButtonBackgroundPointerOver"
                                    Color="#D90429"/>

                                <!-- Color al presionar -->
                                <SolidColorBrush
                                    x:Key="ButtonBackgroundPressed"
                                    Color="#D90429"/>

                                <!-- Texto blanco al pasar el mouse -->
                                <SolidColorBrush
                                    x:Key="ButtonForegroundPointerOver"
                                    Color="White"/>

                                <!-- Texto blanco al presionar -->
                                <SolidColorBrush
                                    x:Key="ButtonForegroundPressed"
                                    Color="White"/>

                                <!-- Borde rojo al pasar el mouse -->
                                <SolidColorBrush
                                    x:Key="ButtonBorderBrushPointerOver"
                                    Color="#D90429"/>

                                <!-- Borde rojo al presionar -->
                                <SolidColorBrush
                                    x:Key="ButtonBorderBrushPressed"
                                    Color="#D90429"/>

                                <SolidColorBrush
                                    x:Key="ButtonBackgroundDisabled"
                                    Color="#D90429"/>

                                <SolidColorBrush
                                    x:Key="ButtonForegroundDisabled"
                                    Color="White"/>

                            </Button.Resources>

                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- BOTÓN CIRCULAR FLOTANTE -->
            <Button x:Name="BtnAbrirChatbot"
                    Width="64"
                    Height="64"
                    CornerRadius="32"
                    Background="#D90429"
                    Foreground="White"
                    BorderBrush="White"
                    BorderThickness="2"
                    HorizontalAlignment="Right"
                    Click="AbrirChatbot_Click"
                    ToolTipService.ToolTip="Abrir asistente IA">

                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver"
                                     Color="#D90429"/>

                    <SolidColorBrush x:Key="ButtonBackgroundPressed"
                                     Color="#D90429"/>

                    <SolidColorBrush x:Key="ButtonForegroundPointerOver"
                                     Color="White"/>

                    <SolidColorBrush x:Key="ButtonForegroundPressed"
                                     Color="White"/>

                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver"
                                     Color="White"/>

                    <SolidColorBrush x:Key="ButtonBorderBrushPressed"
                                     Color="White"/>
                </Button.Resources>

                <FontIcon Glyph="&#xE8F2;"
                          FontFamily="Segoe MDL2 Assets"
                          FontSize="29"/>
            </Button>

        </StackPanel>

    </Grid>
</Page>








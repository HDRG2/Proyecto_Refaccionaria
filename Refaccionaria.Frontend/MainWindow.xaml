<Window
    x:Class="Refaccionaria.Frontend.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Refaccionaria El Pistón">

    <Grid Background="#1C1C1C">

        <Grid.Resources>
            <!-- ===== 1. Colores ===== -->
            <SolidColorBrush x:Key="Rojo"           Color="#C8102E"/>
            <SolidColorBrush x:Key="RojoOscuro"     Color="#8F0B20"/>
            <SolidColorBrush x:Key="Amarillo"       Color="#FFC72C"/>
            <SolidColorBrush x:Key="Asfalto"        Color="#1C1C1C"/>
            <SolidColorBrush x:Key="Panel"          Color="#1C1C1C"/>
            <SolidColorBrush x:Key="Acero"          Color="#4A4A4A"/>
            <SolidColorBrush x:Key="CampoFondo"     Color="#2A2A2A"/>
            <SolidColorBrush x:Key="Blanco"         Color="#FFFFFF"/>
            <SolidColorBrush x:Key="Gris"           Color="#9A9A9A"/>

            <!-- ===== 2. Tipografías ===== -->
            <FontFamily x:Key="Estencil">Big Shoulders Stencil Display, Impact, Arial Black</FontFamily>
            <FontFamily x:Key="Texto">Segoe UI, Arial</FontFamily>

            <!-- ===== 3. Override de colores de sistema (evita blanco en hover/focus) ===== -->
            <SolidColorBrush x:Key="TextControlBackground" Color="#2A2A2A"/>
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#333333"/>
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#2A2A2A"/>
            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#222222"/>
            <SolidColorBrush x:Key="TextControlForeground" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#4A4A4A"/>
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#C8102E"/>
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#C8102E"/>
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#8A8A8A"/>
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#8A8A8A"/>
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#8A8A8A"/>
            <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#C8102E"/>

            <SolidColorBrush x:Key="PasswordBoxBackground" Color="#2A2A2A"/>
            <SolidColorBrush x:Key="PasswordBoxBackgroundPointerOver" Color="#333333"/>
            <SolidColorBrush x:Key="PasswordBoxBackgroundFocused" Color="#2A2A2A"/>
            <SolidColorBrush x:Key="PasswordBoxForeground" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="PasswordBoxForegroundPointerOver" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="PasswordBoxForegroundFocused" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="PasswordBoxBorderBrush" Color="#4A4A4A"/>
            <SolidColorBrush x:Key="PasswordBoxBorderBrushPointerOver" Color="#C8102E"/>
            <SolidColorBrush x:Key="PasswordBoxBorderBrushFocused" Color="#C8102E"/>
            <SolidColorBrush x:Key="PasswordBoxPlaceholderForeground" Color="#8A8A8A"/>

            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="#2A2A2A"/>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="#333333"/>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="#4A4A4A"/>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="#C8102E"/>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#C8102E"/>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#C8102E"/>
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FFFFFF"/>

            <!-- ===== 4. Cajas de texto ===== -->
            <Style x:Key="Campo" TargetType="TextBox">
                <Setter Property="Height" Value="50"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontFamily" Value="{StaticResource Texto}"/>
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="{StaticResource CampoFondo}"/>
                <Setter Property="Foreground" Value="{StaticResource Blanco}"/>
                <Setter Property="BorderBrush" Value="#4A4A4A"/>
                <Setter Property="BorderThickness" Value="2"/>
            </Style>

            <Style x:Key="EstiloContrasena" TargetType="PasswordBox">
                <Setter Property="Height" Value="50"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontFamily" Value="{StaticResource Texto}"/>
                <Setter Property="Padding" Value="12,10,92,10"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="{StaticResource CampoFondo}"/>
                <Setter Property="Foreground" Value="{StaticResource Blanco}"/>
                <Setter Property="BorderBrush" Value="#4A4A4A"/>
                <Setter Property="BorderThickness" Value="2"/>
            </Style>

            <!-- ===== 5. Botón principal (rojo) ===== -->
            <Style x:Key="BotonPrincipal" TargetType="Button">
                <Setter Property="Height" Value="54"/>
                <Setter Property="FontSize" Value="17"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontFamily" Value="{StaticResource Texto}"/>
                <Setter Property="Foreground" Value="{StaticResource Blanco}"/>
                <Setter Property="Background" Value="{StaticResource Rojo}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="CornerRadius" Value="0"/>
            </Style>

            <!-- ===== 6. Botón "Mostrar / Ocultar" ===== -->
            <Style x:Key="BotonTexto" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="13.5"/>
                <Setter Property="FontFamily" Value="{StaticResource Texto}"/>
                <Setter Property="Foreground" Value="{StaticResource Amarillo}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="10,6"/>
            </Style>

            <!-- ===== 7. Selector de rol ===== -->
            <Style x:Key="BotonRolInactivo" TargetType="Button">
                <Setter Property="Background" Value="#2A2A2A"/>
                <Setter Property="Foreground" Value="{StaticResource Gris}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="14.5"/>
                <Setter Property="FontFamily" Value="{StaticResource Texto}"/>
                <Setter Property="Padding" Value="8,12"/>
                <Setter Property="CornerRadius" Value="0"/>
            </Style>

            <Style x:Key="BotonRolActivo" TargetType="Button" BasedOn="{StaticResource BotonRolInactivo}">
                <Setter Property="Background" Value="{StaticResource Rojo}"/>
                <Setter Property="Foreground" Value="{StaticResource Blanco}"/>
            </Style>

            <!-- ===== 8. Etiquetas ===== -->
            <Style x:Key="Etiqueta" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource Gris}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontFamily" Value="{StaticResource Texto}"/>
                <Setter Property="Margin" Value="0,0,0,7"/>
            </Style>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ IZQUIERDA: Cartel rojo con acento amarillo ============ -->
        <Grid Grid.Column="0" Background="{StaticResource Rojo}">

            <Rectangle Fill="#000000" Opacity="0.15" Height="150"
                       VerticalAlignment="Center" Margin="-60,0,-60,120">
                <Rectangle.RenderTransform>
                    <RotateTransform Angle="-6"/>
                </Rectangle.RenderTransform>
            </Rectangle>

            <StackPanel VerticalAlignment="Center" Margin="48,0,48,40">

                <StackPanel Orientation="Horizontal" Margin="0,0,0,28">
                    <Viewbox Width="46" Height="46">
                        <Canvas Width="104" Height="112">
                            <Path Fill="#1C1C1C" Data="M 52,4 L 97,30 L 97,82 L 52,108 L 7,82 L 7,30 Z"/>
                            <Path Fill="#FFC72C" Data="M 39,29 L 65,29 L 65,49 L 39,49 Z M 47,52 L 57,52 L 59,73 L 45,73 Z"/>
                            <Ellipse Canvas.Left="42" Canvas.Top="66" Width="20" Height="20" Fill="#FFC72C"/>
                            <Path Fill="#1C1C1C" Data="M 39,33 L 65,33 L 65,35 L 39,35 Z M 39,38 L 65,38 L 65,40 L 39,40 Z"/>
                            <Ellipse Canvas.Left="48" Canvas.Top="72" Width="8" Height="8" Fill="#1C1C1C"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Refaccionaria" FontWeight="Bold" FontSize="15"
                               Foreground="White"
                               FontFamily="{StaticResource Texto}"
                               VerticalAlignment="Center" Margin="14,0,0,0"/>
                </StackPanel>

                <TextBlock Text="EL" FontFamily="{StaticResource Estencil}"
                           FontSize="96" FontWeight="Black"
                           Foreground="#FFC72C"/>
                <TextBlock Text="PISTÓN" FontFamily="{StaticResource Estencil}"
                           FontSize="140" FontWeight="Black"
                           Foreground="#FFC72C" Margin="-6,-30,0,24"/>

                <TextBlock Text="Motor, frenos, suspensión y eléctrico. Si tu auto lo necesita, aquí está en existencia."
                           FontSize="19" FontWeight="Medium" TextWrapping="Wrap" MaxWidth="420"
                           Foreground="White"
                           FontFamily="{StaticResource Texto}" HorizontalAlignment="Left"/>
            </StackPanel>

            <Grid Height="34" VerticalAlignment="Bottom" Background="#1C1C1C">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M 0,34 L 17,0 L 34,0 L 17,34 Z M 34,34 L 51,0 L 68,0 L 51,34 Z M 68,34 L 85,0 L 102,0 L 85,34 Z M 102,34 L 119,0 L 136,0 L 119,34 Z M 136,34 L 153,0 L 170,0 L 153,34 Z M 170,34 L 187,0 L 204,0 L 187,34 Z M 204,34 L 221,0 L 238,0 L 221,34 Z M 238,34 L 255,0 L 272,0 L 255,34 Z M 272,34 L 289,0 L 306,0 L 289,34 Z M 306,34 L 323,0 L 340,0 L 323,34 Z M 340,34 L 357,0 L 374,0 L 357,34 Z M 374,34 L 391,0 L 408,0 L 391,34 Z M 408,34 L 425,0 L 442,0 L 425,34 Z M 442,34 L 459,0 L 476,0 L 459,34 Z M 476,34 L 493,0 L 510,0 L 493,34 Z M 510,34 L 527,0 L 544,0 L 527,34 Z M 544,34 L 561,0 L 578,0 L 561,34 Z M 578,34 L 595,0 L 612,0 L 595,34 Z"
                          Fill="#FFC72C"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ============ DERECHA: Formulario oscuro con acentos rojo/amarillo ============ -->
        <Grid Grid.Column="1" Background="{StaticResource Panel}">
            <StackPanel VerticalAlignment="Center" MaxWidth="400" Margin="24">

                <TextBlock Text="Iniciar sesión" FontSize="36" FontWeight="Bold"
                           Foreground="{StaticResource Blanco}"
                           FontFamily="{StaticResource Texto}" TextWrapping="Wrap"/>
                <TextBlock Text="Entra con tu usuario para consultar y mover el inventario."
                           Foreground="{StaticResource Gris}" FontSize="15" TextWrapping="Wrap"
                           FontFamily="{StaticResource Texto}" Margin="0,10,0,28"/>

                <!-- Selector de rol -->
                <Grid Margin="0,0,0,22" ColumnSpacing="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BotonRolMostrador" Grid.Column="0"
                            Content="Mostrador"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Style="{StaticResource BotonRolActivo}"
                            Click="BotonRolMostrador_Click"/>

                    <Button x:Name="BotonRolAdministrador" Grid.Column="1"
                            Content="Administrador"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Style="{StaticResource BotonRolInactivo}"
                            Click="BotonRolAdministrador_Click"/>
                </Grid>

                <!-- Recuadro de error -->
                <Border x:Name="CajaError" Visibility="Collapsed"
                        Background="#3A1F1D" BorderBrush="{StaticResource Rojo}"
                        BorderThickness="8,2,2,2" Padding="12,10" Margin="0,0,0,16">
                    <TextBlock x:Name="TextoError" Foreground="#FF8A80"
                               FontWeight="SemiBold" FontSize="14.5" TextWrapping="Wrap"
                               FontFamily="{StaticResource Texto}"/>
                </Border>

                <!-- Usuario -->
                <TextBlock Text="Usuario" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="CampoUsuario" Style="{StaticResource Campo}" Margin="0,0,0,18"/>

                <!-- Contraseña -->
                <TextBlock Text="Contraseña" Style="{StaticResource Etiqueta}"/>
                <Grid Margin="0,0,0,4">
                    <PasswordBox x:Name="CampoClave" Style="{StaticResource EstiloContrasena}"
                                 PasswordRevealMode="Hidden"
                                 Padding="12,10,92,10"/>
                    <TextBox x:Name="CampoClaveVisible" Style="{StaticResource Campo}"
                             Padding="12,10,92,10" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <Button x:Name="BotonVerClave" Content="Mostrar"
                            Style="{StaticResource BotonTexto}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,4,0" Click="BotonVerClave_Click"/>
                </Grid>

                <CheckBox x:Name="Recordar" Content=" Recordar mi usuario en este equipo"
                          Foreground="{StaticResource Gris}"
                          FontSize="14.5" FontFamily="{StaticResource Texto}"
                          Margin="0,8,0,22" VerticalContentAlignment="Center"/>

                <Button x:Name="BotonEntrar" Content="Entrar al sistema"
                        Style="{StaticResource BotonPrincipal}"
                        Click="BotonEntrar_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

